@import "common/buttons.wxss";
page{--tc-ink:#111111;--tc-paper:#ffffff;--tc-surface:#fff;--tc-soft:#f5f5f5;--tc-muted:#707070;--tc-line:#e8e8e8;background:var(--tc-paper);color:var(--tc-ink);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.6}
view,text,image,button,input,textarea{box-sizing:border-box}button{border-radius:12rpx;font-size:28rpx}button::after{border:0}button[disabled]{background:#f1f1f1!important;color:#999999!important}
.primary-button,.secondary-button{display:flex;align-items:center;justify-content:center;min-height:96rpx;padding:22rpx 28rpx;font-size:30rpx;font-weight:600;line-height:1.4;border-radius:999rpx;width:100%;margin-left:0;margin-right:0}
.primary-button{background:#111111;color:#fff}.secondary-button{background:transparent;border:1rpx solid #d4d4d4;color:#111111}.primary-button:active{background:#333}.eyebrow{font-size:22rpx;letter-spacing:2rpx;color:#707070;text-transform:uppercase}.page-shell{padding:44rpx 36rpx 72rpx}.section-title{font-size:44rpx;font-weight:600;line-height:1.3;letter-spacing:0}.section-copy{font-size:28rpx;color:#707070;line-height:1.85}
.error-panel{margin:32rpx;padding:28rpx;border:1rpx solid #e5dcd0;background:#fffaf3;border-radius:16rpx}.error-panel__copy{font-size:26rpx;color:#6d5c48}.error-panel__button{margin-top:20rpx;background:#111111;color:white;font-size:26rpx}.loading-card{padding:72rpx 32rpx;text-align:center;color:#707070}.preview-ribbon{display:none}
.quantity-stepper{display:flex;align-items:center;border:1rpx solid #dfe1d9;width:196rpx;height:68rpx;border-radius:999rpx;overflow:hidden;background:#fff}.quantity-stepper button{width:64rpx;height:66rpx;line-height:62rpx;padding:0;margin:0;background:#fff;font-size:30rpx;border-radius:0}.quantity-stepper view{width:68rpx;text-align:center;font-size:26rpx}.muted{color:#707070}.chevron{width:28rpx;height:28rpx}.status-panel{padding:28rpx;border:1rpx solid #e8e8e8;border-radius:16rpx;background:#fff}.status-panel__title{font-weight:500}.status-panel__copy{font-size:24rpx;color:#707070;margin-top:12rpx}.button--pressed{opacity:.7}.catalog-notice{padding:14rpx 32rpx;font-size:23rpx;color:#685f4e;background:#f0ebe1;line-height:1.6}
button.primary-button,button.secondary-button{width:100%!important;margin-left:0!important;margin-right:0!important}.purchase-bar button.add-button{width:auto!important;min-width:0}.purchase-bar button.bag-button{width:84rpx!important;margin:0!important}.empty button.primary-button{max-width:370rpx}

@import "common/interaction.wxss";
