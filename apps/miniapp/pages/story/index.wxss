.story-page { min-height: 100vh; padding-bottom: 70rpx; background: var(--tc-paper); }
.story-hero { min-height: 650rpx; padding: 108rpx 40rpx 72rpx; background: var(--tc-ink); color: #ffffff; }
.story-hero__eyebrow { color: rgba(255,255,255,.52); font-size: 19rpx; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
.story-hero__title { margin-top: 22rpx; font-size: 58rpx; font-weight: 400; letter-spacing: -.055em; line-height: 1.08; }
.story-hero__copy { max-width: 620rpx; margin-top: 32rpx; color: rgba(255,255,255,.66); font-size: 25rpx; line-height: 1.7; }
.story-content { padding: 70rpx 40rpx 0; }
.manifesto { margin-top: 48rpx; border-top: 2rpx solid var(--tc-ink); }
.manifesto__item { display: grid; grid-template-columns: 72rpx 1fr; gap: 12rpx; padding: 30rpx 0; border-bottom: 2rpx solid var(--tc-line); }
.manifesto__number { color: var(--tc-muted); font-size: 19rpx; }
.manifesto__title { font-size: 28rpx; font-weight: 500; }
.manifesto__copy { margin-top: 9rpx; color: var(--tc-muted); font-size: 23rpx; line-height: 1.62; }
.company-card { margin-top: 70rpx; padding: 34rpx; background: var(--tc-soft); }
.company-card__name { margin: 16rpx 0 32rpx; font-size: 36rpx; font-weight: 500; line-height: 1.3; }
.company-card__row { display: flex; justify-content: space-between; gap: 22rpx; padding: 20rpx 0; border-top: 2rpx solid var(--tc-line); color: var(--tc-muted); font-size: 21rpx; }
.company-card__row text:last-child { color: var(--tc-ink); text-align: right; }
.story-actions { display: grid; gap: 16rpx; margin-top: 28rpx; }
