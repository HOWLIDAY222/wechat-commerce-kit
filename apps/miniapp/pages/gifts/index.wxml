<view class="gift-page">
  <view class="gift-heading"><view class="gift-kicker">A GIFT, JUST FOR YOU</view><view class="gift-title">商品礼品卡</view><view class="gift-copy">送出一份心意，尺码由收礼人决定。</view></view>
  <view class="gift-tabs"><button class="{{tab === 'received' ? 'active' : ''}} vk-button-content" data-tab="received" bindtap="selectTab" disabled="{{busy}}">我收到的</button><button class="{{tab === 'sent' ? 'active' : ''}} vk-button-content" data-tab="sent" bindtap="selectTab" disabled="{{busy}}">我送出的</button><button class="{{tab === 'buy' ? 'active' : ''}} vk-button-content" data-tab="buy" bindtap="selectTab" disabled="{{busy}}">选礼品卡</button></view>
  <view wx:if="{{error}}" class="gift-error">{{error}}<button class="gift-link vk-button-content" bindtap="load" disabled="{{busy}}">刷新核对状态 ↻</button></view><view wx:if="{{notice}}" class="gift-notice">{{notice}}</view>
  <brand-loading wx:if="{{loading}}" label="正在同步礼品卡…" />
  <block wx:if="{{!loading && tab !== 'buy'}}">
    <view wx:if="{{!visibleCards.length}}" class="gift-empty">{{tab === 'received' ? '还没有收到礼品卡' : '还没有送出的礼品卡'}}<text>{{tab === 'received' ? '从朋友发来的赠礼卡片进入，领取后会保存在这里。' : '购买或后台发放的卡片，会保存在这里。'}}</text></view>
    <view class="gift-card" wx:for="{{visibleCards}}" wx:key="id"><view class="gift-card__brand">MerchantKit · GIFT CARD</view><view class="gift-card__body"><image class="gift-card__image" src="{{item.image}}" mode="aspectFill" lazy-load/><view><view class="gift-card__name">{{item.productName}}</view><view class="gift-card__meta">{{item.description}}</view><view class="gift-card__meta">卡号 {{item.shortId}}</view></view></view><view class="gift-card__status">{{item.statusLabel}}{{item.fulfillmentStatus === 'SHIPPED' ? ' · 已发货' : ''}}</view>
      <view class="gift-actions"><button class="gift-primary vk-button-content" wx:if="{{item.canShare && preparedId !== item.id}}" data-id="{{item.id}}" bindtap="prepareShare" disabled="{{busy}}">准备赠送</button><block wx:if="{{item.canShare && preparedId === item.id}}"><button class="gift-primary vk-button-content" open-type="share" data-id="{{item.id}}" bindtap="feedbackTap">发送给朋友</button><button class="gift-secondary vk-button-content" data-id="{{item.id}}" bindtap="useOwn">自己使用</button></block><button class="gift-primary vk-button-content" wx:if="{{item.canRedeem}}" data-id="{{item.id}}" bindtap="redeem" disabled="{{busy}}">选择尺码和地址</button><button class="gift-primary vk-button-content" wx:if="{{item.received && item.status === 'REDEEMING'}}" data-id="{{item.id}}" bindtap="redeem" disabled="{{busy}}">继续支付运费</button><button class="gift-secondary vk-button-content" wx:if="{{item.received && item.redemptionOrderNo}}" data-id="{{item.id}}" bindtap="viewOrder">查看兑换订单</button><block wx:if="{{item.sent && item.status === 'PENDING_PAYMENT'}}"><button class="gift-primary vk-button-content" data-id="{{item.id}}" bindtap="pay" disabled="{{busy}}">继续付款</button><button class="gift-secondary vk-button-content" data-id="{{item.id}}" bindtap="cancel" disabled="{{busy}}">取消购买</button></block></view>
      <button class="gift-link vk-button-content" wx:if="{{item.sent && !item.complimentary && (item.status === 'READY' || item.status === 'CLAIMED')}}" data-id="{{item.id}}" bindtap="refund" disabled="{{busy}}">申请退款</button>
    </view>
  </block>
  <block wx:if="{{!loading && tab === 'buy'}}"><view class="gift-empty" wx:if="{{!offers.length}}">礼品卡暂未开放购买<text>已收到的礼品卡仍可按卡片状态领取和兑换。</text></view><block wx:else><view class="gift-section"><view class="gift-section__title">写一句祝福（选填）</view><textarea class="gift-message" maxlength="120" value="{{message}}" bindinput="inputMessage" placeholder="愿你每天都舒适自在。" disabled="{{busy}}"/></view><view class="gift-card" wx:for="{{offers}}" wx:key="id"><view class="gift-card__body"><image class="gift-card__image" src="{{item.image}}" mode="aspectFill" lazy-load/><view><view class="gift-card__name">{{item.title}}</view><view class="gift-card__meta">{{item.description}}</view><view class="gift-price">¥{{item.price}}</view></view></view><view class="gift-note">商品金额已确定，尺码和地址由收礼人选择。运费另计。</view><button class="gift-primary gift-confirm vk-button-content" data-id="{{item.id}}" bindtap="purchase" disabled="{{busy}}" loading="{{busy}}">购买并赠送</button></view></block></block>
  <button class="gift-link vk-button-content" bindtap="toggleRules">{{showRules ? '收起使用说明 −' : '礼品卡使用说明 ＋'}}</button><view class="gift-rules" wx:if="{{showRules}}">{{rules}}</view><button class="gift-link vk-button-content" bindtap="goService">需要帮助？联系客服 ↗</button>
</view>
<privacy-sheet id="privacy-sheet"/>
