.after-sales-form-page { min-height: 100vh; padding: 48rpx 40rpx 80rpx; background: var(--tc-paper); }
.error-card, .loading-card, .form-card, .notice { margin-top: 26rpx; padding: 30rpx 0; border-top: 2rpx solid var(--tc-line); border-bottom: 2rpx solid var(--tc-line); }
.error-card { border-color: #a53327; color: #7a241a; font-size: 22rpx; }
.loading-card { color: var(--tc-muted); text-align: center; }
.form-card__title { font-size: 26rpx; font-weight: 500; }
.type-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 22rpx; }
.type-chip { padding: 15rpx 20rpx; border: 2rpx solid var(--tc-line); font-size: 21rpx; }
.type-chip--active { border-color: var(--tc-ink); background: var(--tc-ink); color: #ffffff; }
.select-item { display: grid; grid-template-columns: 48rpx 1fr auto; gap: 16rpx; align-items: center; padding: 22rpx 0; border-bottom: 2rpx solid var(--tc-line); }
.select-item:last-child { border-bottom: 0; }
.select-item__check { display: flex; width: 40rpx; height: 40rpx; align-items: center; justify-content: center; border: 2rpx solid #8b8b8b; font-size: 20rpx; }
.select-item__check--active { border-color: var(--tc-ink); background: var(--tc-ink); color: #ffffff; }
.select-item__name { font-size: 23rpx; font-weight: 500; }
.select-item__meta { margin-top: 7rpx; color: var(--tc-muted); font-size: 19rpx; }
.quantity { display: flex; align-items: center; gap: 8rpx; }
.quantity button { display: flex; width: 48rpx; height: 48rpx; align-items: center; justify-content: center; margin: 0; padding: 0; border-radius: 0; background: var(--tc-soft); font-size: 21rpx; line-height: 1; }
.quantity text { min-width: 32rpx; text-align: center; font-size: 20rpx; }
.fields label { display: block; padding: 20rpx 0; border-bottom: 2rpx solid var(--tc-line); color: var(--tc-muted); font-size: 20rpx; }
.fields label:last-child { border-bottom: 0; }
.fields input, .fields textarea { width: 100%; min-height: 54rpx; margin-top: 12rpx; color: var(--tc-ink); font-size: 24rpx; line-height: 1.6; }
.notice { margin-bottom: 24rpx; padding-right: 24rpx; padding-left: 24rpx; background: var(--tc-soft); color: var(--tc-muted); font-size: 21rpx; line-height: 1.62; }

@import '../../common/service-pages.wxss';
