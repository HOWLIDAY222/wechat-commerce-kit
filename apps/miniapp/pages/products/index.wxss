.catalog{padding:32rpx 36rpx 60rpx}.catalog-heading{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:28rpx}.catalog-title{font-size:46rpx;font-weight:600;line-height:1.3;margin-top:8rpx}.catalog-heading>text{font-size:25rpx;color:#707070;padding-bottom:6rpx}.search{display:flex;align-items:center;background:#f5f5f5;padding:0 24rpx;height:88rpx;margin-bottom:30rpx;border-radius:999rpx}.search image{width:30rpx;height:30rpx;margin-right:16rpx}.search input{flex:1;min-width:0;font-size:28rpx}.search button{width:auto!important;margin:0!important;padding:12rpx 8rpx;background:none;font-size:25rpx}.catalog-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:44rpx 20rpx}.catalog-grid--single{grid-template-columns:minmax(0,1fr)}.product-media{position:relative;border-radius:20rpx;overflow:hidden}.product-image{width:100%;height:400rpx;display:block}.catalog-grid--single .product-image{height:510rpx}.product-release{position:absolute;left:20rpx;top:20rpx;border-radius:999rpx;background:#fff;padding:8rpx 18rpx;font-size:23rpx;line-height:1.5}.product-top{display:flex;justify-content:space-between;align-items:baseline;gap:12rpx;margin-top:24rpx;font-size:32rpx;font-weight:600}.product-top text:first-child{font-size:34rpx;line-height:1.4}.product-subtitle{font-size:27rpx;color:#707070;margin-top:10rpx;line-height:1.7}.product-ship{font-size:24rpx;color:#707070;margin-top:10rpx}.product-note{display:flex;align-items:center;gap:16rpx;margin-top:22rpx;font-size:26rpx;color:#707070}.product-note>text{padding:4rpx 10rpx;background:#f5f5f5;border-radius:6rpx}.product-note image{width:26rpx;height:26rpx;margin-left:auto}.product-buy{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:auto!important;min-height:88rpx;margin:0 0 0 auto!important;padding:18rpx 30rpx;line-height:1.4;border-radius:999rpx;background:#111;color:#fff;font-size:27rpx;font-weight:600}.catalog-footer{border-top:1rpx solid #eee;margin-top:36rpx;padding-top:36rpx;text-align:center;color:#707070;font-size:25rpx}.catalog-footer>text{font-size:21rpx;letter-spacing:2rpx}.catalog-footer>view{margin-top:10rpx}.empty{text-align:center;padding:80rpx 0;color:#707070}.empty button{margin-top:30rpx}

.catalog-heading__actions{display:flex;align-items:center;gap:16rpx;flex-shrink:0}

.public-share-entry{width:120rpx;flex:0 0 120rpx}.home-tabs .public-share-entry{margin-left:auto}.product-intro__top .detail-brand{flex:1;font-size:20rpx;letter-spacing:1rpx}
