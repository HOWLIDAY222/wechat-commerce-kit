.after-sales-page { min-height: 100vh; padding: 48rpx 40rpx 80rpx; background: var(--tc-paper); }
.state-card, .error-card, .loading-card { margin-top: 30rpx; padding: 34rpx 0; border-top: 2rpx solid var(--tc-line); border-bottom: 2rpx solid var(--tc-line); }
.state-card__title { margin-bottom: 24rpx; font-size: 30rpx; font-weight: 500; }
.state-card__copy { margin: -8rpx 0 24rpx; color: var(--tc-muted); font-size: 22rpx; }
.error-card { border-color: #a53327; color: #7a241a; font-size: 22rpx; }
.loading-card { color: var(--tc-muted); text-align: center; }
.after-sales-list { margin-top: 32rpx; border-top: 2rpx solid var(--tc-ink); }
.after-sales-filters { display: flex; gap: 16rpx; margin-top: 32rpx; }
.after-sales-filter { flex: 1; margin: 0; min-height: 80rpx; border: 2rpx solid var(--tc-line); border-radius: 0; background: transparent; color: var(--tc-ink); font-size: 24rpx; line-height: 80rpx; padding: 0 16rpx; }
.after-sales-filter::after { border: 0; }
.after-sales-filter--active { background: var(--tc-ink); color: var(--tc-paper); border-color: var(--tc-ink); }
.after-sales-card { padding: 28rpx 0; border-bottom: 2rpx solid var(--tc-line); }
.after-sales-card__head, .after-sales-card__foot { display: flex; align-items: center; justify-content: space-between; color: var(--tc-muted); font-size: 20rpx; }
.after-sales-card__head .status { color: var(--tc-ink); }
.after-sales-card__head { align-items: flex-start; gap: 20rpx; }
.after-sales-card__head > text:first-child { min-width: 0; flex: 1; word-break: break-all; }
.after-sales-card__head .status { flex: none; max-width: 58%; text-align: right; line-height: 1.5; }
.after-sales-card__type { margin-top: 26rpx; font-size: 29rpx; font-weight: 500; }
.after-sales-card__reason { margin-top: 10rpx; color: var(--tc-muted); font-size: 22rpx; }
.after-sales-card__foot { margin-top: 24rpx; padding-top: 20rpx; border-top: 2rpx solid var(--tc-line); }

@import '../../common/service-pages.wxss';
