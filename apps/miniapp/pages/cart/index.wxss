@import "../../common/commerce.wxss";
.cart{box-sizing:border-box;padding:0 24rpx 42rpx;min-height:calc(100vh - 185px)}.cart--with-summary{padding-bottom:240rpx}.cart-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:28rpx 4rpx}.flow-title>text{font-size:24rpx;font-weight:400;color:#777}.cart-heading>button{width:auto!important;flex-shrink:0;margin:0!important;background:none;padding:18rpx 0;font-size:23rpx;line-height:1.6}.cart-item{display:flex;gap:22rpx;transition:opacity .14s ease}.cart-item--updating{opacity:.6}.cart-image{width:188rpx;height:246rpx;flex-shrink:0;border-radius:10rpx;background:#f5f5f4}.missing{font-size:22rpx;display:flex;align-items:center;justify-content:center;color:#777}.item-content{flex:1;min-width:0;display:flex;flex-direction:column}.item-title{font-size:27rpx;font-weight:600;line-height:1.5;overflow-wrap:anywhere}.item-price{font-size:30rpx;font-weight:600;margin-top:10rpx}.item-price>text{font-size:21rpx;color:#777;font-weight:400}.variant{display:flex;align-items:center;justify-content:space-between;gap:8rpx;width:100%!important;margin:14rpx 0!important;padding:12rpx;background:#f6f6f5;font-size:23rpx;line-height:1.6;text-align:left;border-radius:8rpx;color:#555}.variant>text{min-width:0}.variant>image{width:20rpx;height:20rpx;flex-shrink:0}.item-controls{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-top:auto;padding-top:10rpx}.quantity-stepper{width:180rpx;height:76rpx;border-radius:10rpx;border-color:#e4e4e4}.quantity-stepper button{flex:0 0 58rpx;width:58rpx!important;height:74rpx;line-height:70rpx;margin:0!important}.quantity-stepper view{width:62rpx;font-size:25rpx}.remove{width:auto!important;margin:0!important;padding:18rpx 0;background:none;font-size:22rpx;line-height:1.7;color:#777}.unavailable,.item-updating{font-size:22rpx;color:#8c573c;line-height:1.7;margin-bottom:10rpx}.cart-service>view{font-size:26rpx;font-weight:600;margin-bottom:10rpx}.cart-service>text{font-size:24rpx;color:#777;line-height:1.8}.summary{position:fixed;left:0;right:0;bottom:0;z-index:50;padding:20rpx 28rpx 20rpx;background:#fff;border-top:1rpx solid #eee}.summary-main{display:flex;align-items:center;gap:20rpx}.summary-price{flex:1;min-width:0;display:flex;flex-direction:column;gap:5rpx}.summary-label{font-size:21rpx;color:#777}.summary-amount{font-size:38rpx;font-weight:600;line-height:1.3}.summary button.primary-button{width:280rpx!important;flex:0 0 280rpx;margin:0!important}.summary-note{font-size:21rpx;color:#888;margin-top:12rpx;line-height:1.6}.empty{margin-top:8rpx}.empty>image{width:66rpx;height:66rpx;opacity:.6;margin-bottom:24rpx}.empty button.primary-button{max-width:340rpx;margin:0 auto!important}.cart-error{padding:24rpx;margin-bottom:18rpx;background:#fff5ed;border-radius:12rpx;font-size:25rpx;color:#875d3d;line-height:1.8}.cart-error button{margin-top:18rpx}@media(prefers-reduced-motion:reduce){.cart-item{transition:none}}

.quantity-stepper input{width:80rpx;height:64rpx;text-align:center;font-size:27rpx}
