<brand-header show-search="{{false}}" show-bag="{{false}}"/>
<view class="cart flow-page {{cart.items.length?'cart--with-summary':''}}">
 <view class="flow-heading cart-heading"><view><view class="flow-kicker">YOUR SELECTION</view><view class="flow-title">购物袋<text wx:if="{{cart.itemCount}}"> · {{cart.itemCount}} 件</text></view><view class="flow-copy">确认款式与尺码，再继续结算。</view></view><button class="vk-button-content" bindtap="browseProducts" id="cart-continue">继续选购 ↗</button></view>
 <view wx:if="{{syncNotice}}" class="cart-error"><view>{{syncNotice}}</view><button class="secondary-button vk-button-content" bindtap="retry" disabled="{{loading}}">重新同步</button><button wx:if="{{!syncBlocked}}" class="secondary-button vk-button-content" bindtap="useAccountBag" disabled="{{loading}}">仅使用账户购物袋</button></view>
 <view wx:if="{{error}}" class="cart-error"><view>{{error}}</view><button class="secondary-button vk-button-content" bindtap="retry" disabled="{{loading}}">重新加载</button></view>
 <brand-loading wx:if="{{loading&&!cart}}" variant="cart" label="正在更新购物袋…"/>
 <view wx:if="{{cart&&!cart.items.length && !error}}" class="flow-empty empty"><image src="/assets/icons/shopping-bag.png"/><view class="flow-empty__title">购物袋还是空的</view><view class="flow-empty__copy">选好款式、尺码和数量，<view>把舒适带回日常。</view></view><button class="primary-button vk-button-content" bindtap="browseProducts">去选购</button></view>
 <view class="cart-list"><view class="cart-item flow-card {{updatingItemId === item.id ? 'cart-item--updating' : ''}}" wx:for="{{cart.items}}" wx:key="id">
  <image class="cart-image" wx:if="{{item.productImage}}" src="{{item.productImage}}" mode="aspectFit" data-slug="{{item.productSlug}}" bindtap="openProduct"/><view class="cart-image missing" wx:else>商品图片</view>
  <view class="item-content"><view class="item-title" data-slug="{{item.productSlug}}" bindtap="openProduct">{{item.productSlug==='x1-air-white'?'Essential Brief Demo':item.productName}}</view><view class="item-price">{{item.unitPrice}}<text> / 单条价</text></view>
   <button class="variant vk-button-content" id="cart-edit-{{index}}" data-id="{{item.id}}" data-slug="{{item.productSlug}}" data-style="{{item.style}}" data-size="{{item.size}}" data-color="{{item.color}}" data-quantity="{{item.quantity}}" bindtap="editVariant" disabled="{{!!updatingItemId || loading || syncBlocked}}"><text>{{item.styleLabel}} · {{item.color}} / {{item.size}}</text><image src="/assets/icons/chevron-right.png"/></button>
   <view class="unavailable" wx:if="{{item.available===false}}">该规格已不可购买，请调整或移除。</view><view wx:if="{{updatingItemId === item.id}}" class="item-updating" role="status">正在更新数量…</view>
   <view class="item-controls"><view class="quantity-stepper"><button class="vk-button-content" id="cart-minus-{{index}}" aria-label="{{item.quantity===1?'移除这件商品':'减少数量'}}" disabled="{{!!updatingItemId||loading||syncBlocked}}" data-id="{{item.id}}" data-quantity="{{item.quantity}}" data-delta="-1" bindtap="changeQuantity">−</button><input id="cart-quantity-{{index}}" type="number" aria-label="购买数量" maxlength="2" value="{{item.quantity}}" data-id="{{item.id}}" bindblur="inputQuantity" bindconfirm="inputQuantity" disabled="{{!!updatingItemId||loading||syncBlocked}}"/><button class="vk-button-content" id="cart-plus-{{index}}" aria-label="增加数量" disabled="{{!!updatingItemId||loading||syncBlocked||item.quantity>=item.quantityLimit}}" data-id="{{item.id}}" data-quantity="{{item.quantity}}" data-delta="1" bindtap="changeQuantity">+</button></view><button class="remove vk-button-content" disabled="{{!!updatingItemId||loading||syncBlocked}}" data-id="{{item.id}}" bindtap="removeItem">移除</button></view>
  </view>
 </view></view>
 <view wx:if="{{cart.items.length}}" class="cart-service flow-card"><view>选购说明</view><text>两条起享组合价，超过四条自动拆分最省组合。同款式不同尺码可合并计算组合价；不同款式分别计价。最终优惠与运费以结算页为准。</text></view>
 <view wx:if="{{cart.items.length}}" class="summary"><view class="summary-main"><view class="summary-price"><text class="summary-label">商品小计 · {{cart.itemCount}} 件</text><text class="summary-amount">{{cart.subtotal}}</text></view><button id="cart-checkout" class="primary-button vk-button-content" disabled="{{!!updatingItemId||loading||syncBlocked||!!error||cart.hasUnavailable}}" bindtap="goCheckout">{{loggedIn?(cart.guest?'同步购物袋':'去结算'):'登录并结算'}}</button></view><view class="summary-note">{{!loggedIn?'所选商品保留在本机，登录后继续结算。':'已含组合优惠，运费在结算时确认。'}}</view></view>
</view>
<privacy-sheet id="privacy-sheet"/>
