page{background:#fff;color:#111}.privacy-page{height:100vh;box-sizing:border-box;display:flex;flex-direction:column;background:#fff}.privacy-heading{flex:none;padding:24rpx 34rpx 26rpx;border-bottom:1rpx solid #e9e9e9}.privacy-heading image{display:block;width:330rpx;height:58rpx;margin-bottom:24rpx}.privacy-heading>view{font-size:38rpx;line-height:1.4;font-weight:600}.privacy-document{flex:1;min-height:0;height:0}.privacy-document__body{padding:30rpx 34rpx 50rpx}.privacy-choice{font-size:27rpx;line-height:1.8;color:#444;margin-bottom:30rpx}.privacy-mini-title{font-size:32rpx;font-weight:600;margin:44rpx 0 24rpx}.privacy-footer{flex:none;padding:22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));border-top:1rpx solid #e6e6e6;background:#fff}.privacy-footer button{min-height:92rpx;display:flex;align-items:center;justify-content:center;width:100%!important;margin:0!important;border-radius:12rpx;padding:22rpx 24rpx;font-size:28rpx;line-height:1.6;font-weight:500}.privacy-primary{background:#111;color:#fff}.privacy-secondary{background:#fff;color:#444;border:1rpx solid #d7d7d7;margin-top:14rpx!important}.privacy-footer .privacy-secondary{margin-top:14rpx!important}.privacy-native-link{background:#f4f4f4;border-radius:12rpx;padding:22rpx;margin-top:34rpx;font-size:26rpx;line-height:1.8;color:#333}.privacy-error{padding:0 0 18rpx;font-size:25rpx;line-height:1.7;color:#444}
