@import "../../common/member-operations.wxss";
.survey-page{padding-bottom:64rpx}.survey-intro{margin-bottom:42rpx;max-width:610rpx}.survey-list-card{padding:32rpx;margin-top:24rpx}.survey-list-card__top{display:flex;justify-content:space-between;align-items:center;gap:20rpx;margin-bottom:16rpx}.survey-count{font-size:23rpx;color:#777;white-space:nowrap}.survey-list-card .operations-meta{margin-top:18rpx}.survey-list-card .operations-button{margin-top:28rpx!important}.survey-topline{display:flex;justify-content:space-between;align-items:center;gap:24rpx;margin-bottom:36rpx}.survey-name{font-size:31rpx;font-weight:500;line-height:1.5;flex:1;min-width:0}.survey-page .survey-close{flex:none;width:auto!important;margin:0!important;min-height:72rpx;padding:14rpx 20rpx;display:flex;align-items:center;border:1rpx solid #ddd;border-radius:12rpx;background:#fff;color:#555;font-size:23rpx;line-height:1.5}.survey-progress{display:flex;align-items:center;justify-content:space-between;font-size:23rpx;color:#777;margin-bottom:18rpx}.survey-progress__track{height:6rpx;border-radius:10rpx;background:#e5e5e5;overflow:hidden}.survey-progress__fill{height:100%;background:#111;border-radius:10rpx;transition:width .18s ease}.survey-question-card{padding:38rpx 28rpx;margin-top:32rpx}.survey-question-meta{font-size:23rpx;color:#777;line-height:1.7;margin-bottom:16rpx}.survey-question-title{font-size:35rpx;font-weight:500;line-height:1.65;margin-bottom:30rpx}.survey-page .survey-choice{box-sizing:border-box;min-height:94rpx;padding:22rpx 20rpx;margin-top:16rpx;gap:14rpx;border:1rpx solid #e4e4e4;border-radius:14rpx;background:#fff;font-size:27rpx;line-height:1.65}.survey-page .survey-choice.is-selected{border-color:#111;background:#f4f4f4}.survey-choice text{flex:1;min-width:0}.survey-page .survey-written{height:280rpx;font-size:27rpx;line-height:1.85;padding:22rpx}.survey-text-count{text-align:right;font-size:22rpx;color:#888;margin-top:12rpx}.survey-footer{margin-top:34rpx}.survey-footer__actions{display:flex;gap:18rpx}.survey-footer__actions .operations-button{flex:1;margin:0!important;min-height:92rpx;font-size:28rpx}.survey-page .operations-button[disabled]{background:#e6e6e6!important;color:#999!important}.survey-page .survey-skip{width:auto!important;min-height:76rpx;line-height:1.5;padding:18rpx 22rpx;margin:12rpx auto 0!important;border-radius:12rpx;background:transparent;color:#666;font-size:24rpx}.survey-footer__note{font-size:22rpx;line-height:1.8;color:#888;text-align:center;margin-top:18rpx}.survey-review{margin-top:40rpx}.survey-review-row{display:flex;align-items:flex-start;gap:20rpx;padding:28rpx 0;border-bottom:1rpx solid #e3e3e3}.survey-review-row__body{flex:1;min-width:0}.survey-review-row__title{font-size:24rpx;color:#777;line-height:1.7}.survey-review-row__answer{font-size:27rpx;line-height:1.8;margin-top:10rpx;color:#111;overflow-wrap:anywhere;white-space:pre-wrap}.survey-page .survey-edit{flex:none;width:auto!important;min-height:64rpx;padding:12rpx 18rpx;margin:0!important;border:1rpx solid #ddd;border-radius:10rpx;background:#fff;font-size:23rpx;color:#444;line-height:1.6}.survey-review .operations-confirm{margin-top:32rpx}.survey-review .operations-copy{margin-bottom:16rpx}
@media(max-width:340px){.survey-question-title{font-size:32rpx}.survey-question-card{padding:30rpx 22rpx}.survey-page .survey-choice{padding:20rpx 14rpx;font-size:26rpx}.survey-footer__actions{gap:12rpx}.survey-page .survey-close{font-size:22rpx;padding:14rpx}}
