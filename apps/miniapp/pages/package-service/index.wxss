page{background:#fff}
.package-page{padding:0 32rpx calc(44rpx + env(safe-area-inset-bottom))}
.package-heading{padding:40rpx 0 34rpx}
.package-title{font-size:54rpx;line-height:1.35;font-weight:600;letter-spacing:1rpx}
.package-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx}
button.service-card{display:flex;flex-direction:column;align-items:flex-start;min-width:0;width:100%!important;min-height:338rpx;margin:0!important;padding:30rpx 26rpx;border:1rpx solid #ececec;border-radius:24rpx;background:#f7f7f7;color:#141414;text-align:left;white-space:normal;line-height:1.5}
button.service-card--size{background:#f0efed;border-color:#f0efed}
button.service-card--care{background:#f7f7f7;border-color:#f7f7f7}
button.service-card--member{background:#1b1b1b;border-color:#1b1b1b;color:#fff}
button.service-card--after{background:#fff;border-color:#dedede}
.service-card__icon{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;border-radius:50%;background:#fff;margin-bottom:22rpx}
.service-card__icon image{width:46rpx;height:46rpx}
.service-card--member .service-card__icon{background:#353535}
.service-card__title{font-size:32rpx;font-weight:500;line-height:1.5;margin-bottom:24rpx}
.service-card__action{display:flex;align-items:center;justify-content:center;min-height:70rpx;width:100%;margin-top:auto;padding:14rpx 8rpx;background:#191919;color:#fff;border-radius:999rpx;font-size:25rpx;font-weight:500;line-height:1.5;text-align:center}
.service-card--member .service-card__action{background:#fff;color:#151515}
.service-card--pressed{opacity:.76;transform:scale(.985)}
.package-footer{display:flex;gap:20rpx;margin-top:30rpx}
.package-footer button{display:flex;align-items:center;justify-content:center;flex:1;width:auto!important;min-width:0;min-height:48px;margin:0!important;padding:20rpx 8rpx;border-radius:999rpx;font-size:27rpx;line-height:1.5;font-weight:500}
.package-help{background:#f2f2f2;color:#333}.package-shop{background:#fff;color:#333;border:1rpx solid #d8d8d8}
.package-status{display:flex;flex-direction:column;align-items:center;gap:28rpx;min-height:55vh;padding:100rpx 44rpx 48rpx;text-align:center;font-size:28rpx;color:#666}
.package-status__title{font-size:48rpx;font-weight:600;color:#111}.package-status .primary-button{max-width:540rpx;margin-top:8rpx}
.package-spinner{width:46rpx;height:46rpx;border:3rpx solid #eee;border-top-color:#222;border-radius:50%;animation:package-spin .8s linear infinite}
.package-text-button{min-height:44px;margin:12rpx 0 0!important;padding:18rpx 30rpx;background:transparent;color:#555;font-size:27rpx;line-height:1.5}
