@import "../../common/commerce.wxss";
.home-page{padding-bottom:32rpx}.home-top{display:flex;align-items:center;gap:20rpx;padding:20rpx 28rpx 12rpx;background:#fff}.home-search{flex:1;width:auto!important;min-width:0;display:flex;align-items:center;gap:14rpx;padding:0 22rpx;height:76rpx;border-radius:12rpx;background:#f5f5f4;color:#777;font-size:25rpx;text-align:left;margin:0!important}.home-search image{width:30rpx;height:30rpx}.home-tabs{display:flex;align-items:center;gap:34rpx;padding:8rpx 28rpx 18rpx;background:#fff}.home-tabs button{width:auto!important;min-height:68rpx;padding:14rpx 0;margin:0!important;background:none;font-size:26rpx;line-height:1.5;color:#777;border-radius:0}.home-tabs button.home-tab--active{color:#111;font-weight:600;border-bottom:3rpx solid #111}
.campaign{background:#fff;margin:18rpx 24rpx;border-radius:16rpx;overflow:hidden}.hero-frame{height:430rpx}.hero-photo{width:100%;height:100%;display:block}.hero-copy{padding:26rpx}.campaign-caption{font-size:20rpx;letter-spacing:2rpx;color:#777;margin-bottom:8rpx}.hero-title{font-size:38rpx;font-weight:600;line-height:1.4}.hero-subtitle{font-size:25rpx;color:#737373;margin-top:12rpx;line-height:1.8}.hero-purchase{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:22rpx;padding-top:20rpx;border-top:1rpx solid #eee}.hero-product-meta{display:flex;align-items:baseline;gap:14rpx;font-size:21rpx;color:#777}.hero-product-price{font-size:38rpx;font-weight:600;color:#111}.hero-product-price>text{font-size:21rpx;font-weight:400;color:#777}.hero-ship{font-size:21rpx;color:#777;margin-top:6rpx}.hero-action-row{flex-shrink:0}.hero-action-row button.primary-button{width:auto!important;min-width:170rpx;min-height:86rpx;padding:18rpx 22rpx;font-size:25rpx}.release-note{font-size:22rpx;color:#777;line-height:1.7;margin-top:14rpx}
.home-section{padding:28rpx 26rpx;margin:18rpx 24rpx;background:#fff;border-radius:16rpx}.section-banner{display:block;width:100%;border-radius:10rpx;margin-bottom:24rpx}.section-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.home-heading{font-size:32rpx;line-height:1.5;font-weight:600}.section-head button{width:auto!important;min-height:72rpx;margin:0!important;padding:14rpx 0;background:none;display:flex;align-items:center;gap:6rpx;font-size:24rpx;line-height:1.5;flex-shrink:0}.section-head image{width:22rpx;height:22rpx}.detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin-top:22rpx}.detail-story{min-width:0}.detail-story>image{width:100%;height:300rpx;display:block;border-radius:10rpx;background:#f5f5f4}.detail-title{font-size:26rpx;font-weight:600;margin-top:16rpx;line-height:1.5}.detail-copy{font-size:24rpx;line-height:1.8;color:#737373;margin-top:8rpx}.detail-price{font-size:28rpx;font-weight:600;margin-top:10rpx}.detail-story button.secondary-button{margin-top:16rpx;min-height:76rpx;font-size:24rpx}

.home-tabs{gap:28rpx}.home-tabs share-entry{margin-left:auto;flex-shrink:0}

.public-share-entry{width:120rpx;flex:0 0 120rpx}.home-tabs .public-share-entry{margin-left:auto}.product-intro__top .detail-brand{flex:1;font-size:20rpx;letter-spacing:1rpx}

.hero-frame{height:500rpx;background:#f3f3f1}.hero-frame--editorial{height:auto;min-height:300rpx}.hero-frame--editorial .hero-photo{height:auto}.hero-intro-link,.hero-editorial-link{width:auto!important;margin:16rpx 0 0!important;padding:12rpx 0;background:none;display:flex;align-items:center;gap:8rpx;font-size:24rpx;line-height:1.5;color:#555;text-align:left}.hero-intro-link image{width:22rpx;height:22rpx}.detail-story>image.detail-story__photo{height:auto}


.home-search,.hero-intro-link,.hero-editorial-link{justify-content:flex-start}

.campaign-video-frame{position:relative;width:100%;height:0;padding-top:75%;background:#f5f5f4;overflow:hidden}.campaign-video,.campaign-video-poster{position:absolute;top:0;left:0;display:block;width:100%;height:100%}.campaign-video-caption{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:12rpx 26rpx;color:#737373;font-size:21rpx;line-height:1.6}.campaign-video-caption>text:first-child{flex:1}.campaign-video-sound{width:auto!important;min-height:64rpx;margin:0!important;padding:12rpx 4rpx;flex-shrink:0;background:none;color:#111;font-size:23rpx;line-height:1.5;text-decoration:underline}.campaign-video-error{padding:0 26rpx 12rpx;color:#737373;font-size:22rpx;line-height:1.7}


.home-reminder{display:flex;flex-direction:column;align-items:flex-start;gap:24rpx;margin-top:40rpx;padding:30rpx;background:#f4f4f4;border-radius:16rpx}.home-reminder__title{font-size:29rpx;line-height:1.6;font-weight:500;color:#111}.home-reminder__button.home-reminder__button{width:auto!important;min-height:76rpx;padding:17rpx 30rpx!important;margin:0!important;border:1rpx solid #111;border-radius:10rpx;background:#111;color:#fff;font-size:25rpx;line-height:1.6;font-weight:500}.home-reminder__button:after{border:0}
