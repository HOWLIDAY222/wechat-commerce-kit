<brand-header back show-search="{{false}}" show-bag="{{false}}"/><view class="document {{isEditorial ? 'document--editorial' : ''}}"><view class="document-title">{{title}}</view><view wx:if="{{missing}}">请通过品牌官网查阅最新信息。</view><view wx:if="{{notice}}" class="document-source">{{notice}}<button class="vk-button-content" bindtap="retry">重新同步</button></view><view wx:if="{{loading}}" class="document-source">正在更新</view><rich-text nodes="{{nodes}}" selectable/><view wx:if="{{actions.length}}" class="document-actions"><button wx:for="{{actions}}" wx:key="pageKey" class="secondary-button vk-button-content" data-link="{{item}}" bindtap="openLink">{{item.label}}</button></view><view class="document-source" wx:if="{{wordingUpdatedAt}}">小程序文字说明更新：{{wordingUpdatedAt}}</view><view class="document-actions" wx:if="{{isEditorial}}"><button wx:if="{{showShoppingAction}}" class="primary-button vk-button-content" bindtap="goShopping">查看全部商品</button><button class="secondary-button vk-button-content" bindtap="openContact">{{pageKey==='size-guide'?'尺码咨询':'联系品牌'}}</button></view><view class="document-source" wx:if="{{source}}">{{wordingUpdatedAt ? '参考：MerchantKit 官网' : '来源：MerchantKit 官网'}} · 同步日期：{{syncedAt}}<text wx:if="{{version}}"> · 版本 {{version}}</text><button class="vk-button-content" bindtap="copySource">查看官网版本（复制链接）</button></view></view>
<privacy-sheet id="privacy-sheet"/>
