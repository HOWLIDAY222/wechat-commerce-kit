page{background:#f5f5f5;color:#161616}
.subscriptions-page{padding:40rpx 32rpx 80rpx;min-height:85vh;background:#f5f5f5;color:#161616}
.subscriptions-title{font-size:46rpx;font-weight:600;line-height:1.4;margin-bottom:42rpx}
.subscriptions-group{margin-top:46rpx}.subscriptions-group-title{font-size:31rpx;line-height:1.6;font-weight:600;margin-bottom:20rpx}
.subscriptions-row{margin-top:18rpx}.subscriptions-select{display:flex;align-items:center;gap:22rpx;width:100%!important;min-height:120rpx;padding:28rpx;margin:0!important;border:1rpx solid #dedede;border-radius:18rpx;background:#fff;color:#161616;text-align:left;white-space:normal;line-height:1.6;font-weight:400}
.subscriptions-select--selected{border-color:#333}.subscriptions-select--unavailable{opacity:.65}.subscriptions-select__body{display:flex;align-items:center;justify-content:space-between;gap:16rpx;flex:1;min-width:0}
.subscriptions-check{display:flex;align-items:center;justify-content:center;width:36rpx;height:36rpx;flex:0 0 36rpx;border:1rpx solid #b9b9b9;border-radius:8rpx;background:#fff}.subscriptions-check--checked{background:#171717;border-color:#171717;color:#fff}.subscriptions-check text{font-size:25rpx;line-height:1}
.subscriptions-row-title{font-size:29rpx;line-height:1.6;font-weight:500}.subscriptions-row-meta{font-size:25rpx;line-height:1.8;color:#777;font-weight:400;flex-shrink:0}
.subscriptions-page .primary-button,.subscriptions-page .secondary-button{display:flex;align-items:center;justify-content:center;width:100%!important;min-height:94rpx;padding:24rpx 26rpx;margin-left:0!important;margin-right:0!important;border-radius:14rpx;font-size:28rpx;font-weight:500;line-height:1.6}.subscriptions-page .primary-button{background:#171717;color:#fff;border:1rpx solid #171717}.subscriptions-page .secondary-button{background:#fff;color:#222;border:1rpx solid #cfcfcf}.subscriptions-authorize{margin-top:24rpx!important}
.subscriptions-account,.subscriptions-sync{margin-top:28rpx}.subscriptions-error,.subscriptions-notice{padding:26rpx 28rpx;margin-top:26rpx;border:1rpx solid #dedede;border-radius:16rpx;background:#fff;color:#454545;font-size:27rpx;line-height:1.8;white-space:pre-wrap}
.subscriptions-text-button{display:flex;align-items:center;justify-content:center;min-height:88rpx;width:100%!important;padding:20rpx 24rpx;margin:20rpx 0 0!important;border:1rpx solid #d0d0d0;border-radius:12rpx;background:#fff;font-size:27rpx;line-height:1.7;color:#333}
.subscriptions-management{margin-top:48rpx;border:1rpx solid #dedede;border-radius:18rpx;background:#fff;overflow:hidden}.subscriptions-management__toggle{display:flex;align-items:center;justify-content:space-between;gap:24rpx;width:100%!important;min-height:112rpx;padding:28rpx;margin:0!important;background:#fff;border-radius:0;color:#222;line-height:1.6;text-align:left}.subscriptions-management__title{font-size:29rpx;font-weight:500}.subscriptions-management__toggle>text{font-size:25rpx;color:#777;font-weight:400}.subscriptions-management__body{padding:0 28rpx 10rpx}.subscriptions-management__row{display:flex;align-items:center;justify-content:space-between;gap:22rpx;min-height:126rpx;padding:26rpx 0;border-top:1rpx solid #ebebeb}.subscriptions-management__row>view{flex:1;min-width:0}.subscriptions-management__row switch{flex:none;transform:scale(.9);transform-origin:right center}.subscriptions-management__empty{font-size:27rpx;line-height:1.8;color:#777;padding:8rpx 0 24rpx}.subscriptions-remove{width:auto!important;min-height:72rpx;padding:14rpx 24rpx;margin:0!important;border:1rpx solid #ccc;border-radius:10rpx;background:#fff;font-size:26rpx;line-height:1.6;color:#333}
.subscriptions-privacy{display:flex;align-items:center;justify-content:center;min-height:88rpx;margin:26rpx auto 0!important;padding:16rpx 28rpx;background:transparent;font-size:26rpx;color:#666;line-height:1.7;width:auto!important}.subscriptions-pressed{opacity:.7}
@media(max-width:340px){.subscriptions-page{padding-left:26rpx;padding-right:26rpx}.subscriptions-select{padding:24rpx 20rpx;gap:16rpx}.subscriptions-row-meta{font-size:24rpx}.subscriptions-select__body{gap:12rpx}}
