@import "../../common/commerce.wxss";
.checkout-page{min-height:100vh;box-sizing:border-box;padding:24rpx 24rpx calc(210rpx + env(safe-area-inset-bottom));background:var(--vk-bg)}.checkout-heading{padding:8rpx 8rpx 32rpx}.checkout-heading .eyebrow{font-size:20rpx;letter-spacing:2rpx;color:#888}.checkout-heading .section-title{font-size:44rpx;font-weight:600;margin-top:12rpx}.checkout-heading .section-copy{font-size:25rpx;color:#777;margin-top:14rpx}.checkout-error{padding:24rpx;margin:0 0 20rpx;border-radius:12rpx;background:#fff0e6;color:#874b26;font-size:25rpx;line-height:1.8}.checkout-loading{padding:80rpx 0;text-align:center;font-size:27rpx;color:#777}.checkout-section{box-sizing:border-box;display:block;width:100%!important;padding:28rpx;margin:0 0 18rpx!important;border-radius:16rpx;background:#fff;text-align:left;line-height:1.5}.checkout-section__head{display:flex;align-items:center;justify-content:space-between;gap:20rpx;font-size:28rpx;font-weight:600}.section-meta{font-size:23rpx;color:#888;font-weight:400}.checkout-section__action{display:flex;align-items:center;gap:4rpx;font-size:24rpx;color:#777;font-weight:400}.checkout-section__action image,.checkout-member-links image{width:24rpx;height:24rpx;flex-shrink:0}.address-line{display:flex;flex-wrap:wrap;align-items:center;gap:10rpx 20rpx;margin-top:24rpx;font-size:27rpx;color:#666}.address-line__name{font-size:30rpx;font-weight:600;color:#111}.address-detail,.address-missing{margin-top:12rpx;font-size:26rpx;line-height:1.8;color:#666}.address-missing{padding-bottom:10rpx}.address-section[disabled]{color:#111;opacity:.65}.checkout-item{display:grid;grid-template-columns:132rpx minmax(0,1fr) auto;gap:18rpx;align-items:start;padding:26rpx 0;border-bottom:1rpx solid #eee}.checkout-item:last-child{border-bottom:0;padding-bottom:0}.checkout-item>image{width:132rpx;height:160rpx;background:#f5f5f5;border-radius:10rpx}.checkout-item__name{font-size:26rpx;line-height:1.65;font-weight:500;overflow-wrap:anywhere}.checkout-item__variant,.checkout-item__quantity{font-size:24rpx;color:#888;margin-top:10rpx}.checkout-item__quantity{margin-top:18rpx}.checkout-item__total{font-size:27rpx;line-height:1.65;font-weight:600;white-space:nowrap}.benefits-status{font-size:25rpx;margin-top:18rpx;line-height:1.7;color:#555}.checkout-member-links{display:flex;gap:14rpx;margin-top:20rpx}.checkout-member-links button{flex:1;width:auto!important;min-width:0;margin:0!important;padding:20rpx 18rpx;min-height:82rpx;display:flex;align-items:center;justify-content:space-between;gap:6rpx;background:var(--vk-bg);border-radius:10rpx;line-height:1.5;font-size:25rpx;color:#111}.benefits-note{font-size:23rpx;line-height:1.8;color:#888;margin-top:18rpx}.totals>view{display:flex;justify-content:space-between;gap:20rpx;padding:12rpx 0;font-size:26rpx;color:#555}.totals>.checkout-section__head{padding-top:0;padding-bottom:20rpx;font-size:28rpx;color:#111}.totals .totals__payable{margin-top:14rpx;padding-top:24rpx;border-top:1rpx solid #eee;color:#111;font-size:30rpx;font-weight:600}.payment-method{display:flex;align-items:center;gap:12rpx;font-size:26rpx;font-weight:400}.payment-check{display:flex;align-items:center;justify-content:center;width:34rpx;height:34rpx;background:#111;color:#fff;border-radius:50%;font-size:22rpx}.checkout-notice{font-size:23rpx;color:#888;line-height:1.8;margin-top:18rpx}.checkout-bar{position:fixed;bottom:0;left:0;right:0;z-index:50;display:flex;align-items:center;gap:20rpx;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid #eee;background:#fff}.checkout-bar__amount{flex:1;min-width:0;display:flex;flex-direction:column;gap:8rpx}.checkout-bar__label{font-size:22rpx;color:#888}.checkout-bar__price{font-size:40rpx;font-weight:600;line-height:1.3;overflow-wrap:anywhere}.checkout-bar .submit-button{flex:0 0 280rpx;width:280rpx!important;min-width:0;min-height:96rpx;margin:0!important;padding:22rpx 12rpx;font-size:28rpx;border-radius:12rpx}
.address-section{font-weight:400}

button.pickup-method{justify-content:flex-start}.pickup-method__radio{flex-shrink:0}

.checkout-heading .section-title{font-size:42rpx}.checkout-section{padding:26rpx}.checkout-member-links{gap:10rpx}.checkout-member-links button{font-size:23rpx;padding:18rpx 14rpx}.checkout-edit{width:auto!important;margin:0!important;min-height:68rpx;padding:12rpx 0;background:none;font-size:23rpx;font-weight:400;line-height:1.6;flex-shrink:0}.checkout-retry{margin-bottom:16rpx}.checkout-empty{margin-top:12rpx}.checkout-empty button{max-width:360rpx;margin:auto!important}

.pickup-methods{display:grid;grid-template-columns:1fr;gap:18rpx;margin-top:24rpx}.pickup-method{width:100%!important;min-height:92rpx;margin:0!important;padding:22rpx 24rpx;display:flex;align-items:center;gap:18rpx;border:2rpx solid #e5e5e5;border-radius:12rpx;background:#fff;color:#111;font-size:28rpx;text-align:left}.pickup-method--selected{border-color:#111;background:#f8f8f8}.pickup-method__radio{width:30rpx;height:30rpx;border:2rpx solid #aaa;border-radius:50%;box-sizing:border-box}.pickup-method--selected .pickup-method__radio{border:9rpx solid #111}.pickup-free{margin-left:auto;color:#666;font-size:24rpx}.pickup-unavailable{font-size:26rpx;line-height:1.7;color:#777;margin-top:22rpx}.pickup-point{border-top:1rpx solid #eee;margin-top:26rpx;padding-top:22rpx;font-size:26rpx;line-height:1.8;color:#555;overflow-wrap:anywhere}.pickup-point__name{font-weight:600;color:#111;font-size:29rpx;margin-bottom:10rpx}
