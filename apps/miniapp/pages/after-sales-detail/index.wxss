.after-sales-detail-page { min-height: 100vh; padding: 40rpx 40rpx 80rpx; background: var(--tc-paper); }
.loading-card, .error-card, .status-card, .detail-card { margin-bottom: 24rpx; padding: 30rpx 0; border-top: 2rpx solid var(--tc-line); border-bottom: 2rpx solid var(--tc-line); }
.loading-card { color: var(--tc-muted); text-align: center; }
.error-card { border-color: #a53327; color: #7a241a; font-size: 22rpx; }
.status-card { margin-right: -40rpx; margin-left: -40rpx; padding: 54rpx 40rpx; border: 0; background: var(--tc-ink); color: #ffffff; }
.status-card .eyebrow { color: rgba(255,255,255,.52); }
.status-card__title { margin-top: 18rpx; font-size: 46rpx; font-weight: 400; }
.status-card__copy { margin-top: 14rpx; color: rgba(255,255,255,.66); font-size: 22rpx; }
.refund-summary { margin-bottom: 24rpx; padding: 26rpx 24rpx; background: #f4f4f4; border-radius: 10rpx; }
.refund-summary__title { margin-bottom: 14rpx; color: #737373; font-size: 23rpx; }
.refund-summary__row { display: flex; justify-content: space-between; gap: 24rpx; color: #171717; font-size: 28rpx; line-height: 1.7; font-weight: 500; }
.refund-summary__row + .refund-summary__row { margin-top: 12rpx; }
.refund-summary__row text:last-child { min-width: 0; text-align: right; word-break: break-all; }
.detail-card__title { font-size: 26rpx; font-weight: 500; }
.detail-card__reason { margin-top: 20rpx; font-size: 24rpx; font-weight: 500; }
.detail-card__copy, .detail-card__hint { margin-top: 12rpx; color: var(--tc-muted); font-size: 21rpx; line-height: 1.62; }
.detail-card__copy--important { color: var(--tc-ink); font-weight: 500; white-space: pre-wrap; }
.item-row, .amount-row { display: flex; justify-content: space-between; gap: 20rpx; padding: 20rpx 0; border-bottom: 2rpx solid var(--tc-line); font-size: 22rpx; }
.item-row:last-child { border-bottom: 0; }
.item-row__name { font-weight: 500; }
.item-row__meta { margin-top: 7rpx; color: var(--tc-muted); font-size: 19rpx; }
.amount-row { border-bottom: 0; font-size: 26rpx; font-weight: 500; }
.section-heading { display: flex; align-items: center; justify-content: space-between; }
.section-heading__meta, .empty-copy { color: var(--tc-muted); font-size: 20rpx; }
.evidence-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4rpx; margin-top: 22rpx; }
.evidence-image { width: 100%; height: 180rpx; background: var(--tc-soft); }
.form-input, .message-input { width: 100%; margin-top: 18rpx; padding: 22rpx 0; border-bottom: 2rpx solid var(--tc-line); background: #fff; font-size: 23rpx; }
.message-input { min-height: 118rpx; }
.primary-button, .secondary-button { margin-top: 20rpx; border-radius: 0; font-size: 22rpx; font-weight: 600; }
.primary-button { color: #fff; background: var(--tc-ink); }
.secondary-button { color: var(--tc-ink); background: var(--tc-soft); }
.message-row { margin-top: 22rpx; padding: 20rpx; background: var(--tc-soft); }
.message-row--user { margin-left: 36rpx; background: var(--tc-ink); color: #fff; }
.message-row__meta { color: var(--tc-muted); font-size: 18rpx; }
.message-row--user .message-row__meta { color: rgba(255,255,255,.58); }
.message-row__body { margin-top: 9rpx; font-size: 22rpx; line-height: 1.58; white-space: pre-wrap; }

@import '../../common/service-pages.wxss';
