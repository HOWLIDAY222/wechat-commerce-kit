@import "../../common/commerce.wxss";
.member-page{padding:0 24rpx 64rpx;background:var(--vk-bg);color:#111;min-height:100vh;box-sizing:border-box}
.member-summary{padding:28rpx 30rpx 16rpx;background:#fff;color:#111;border-radius:16rpx}.member-summary__brand{font-size:20rpx;letter-spacing:3rpx;color:#888}.member-summary__head{display:flex;align-items:baseline;justify-content:space-between;gap:12rpx;margin-top:14rpx}.member-summary__title{font-size:32rpx;font-weight:600}.member-summary__head>text{font-size:21rpx;color:#888}.member-summary__stats{display:flex;margin-top:18rpx;border-top:1rpx solid #eee}.member-summary__stats button{flex:1;margin:0;background:transparent;color:#777;padding:18rpx 0 8rpx;min-height:110rpx;font-size:24rpx;line-height:1.6;border-radius:0}.member-summary__stats button+button{border-left:1rpx solid #eee}.member-summary__number{color:#111;font-size:42rpx;font-weight:600;line-height:1.25}.member-summary__copy{font-size:25rpx;color:#777;line-height:1.8;padding:18rpx 0}.member-summary button::after{border:0}
.member-tabs{display:flex;border-bottom:1rpx solid #e5e5e5;margin:24rpx 0}.member-tabs button{flex:1;min-height:92rpx;margin:0;padding:20rpx 0;background:transparent;color:#707070;font-size:29rpx;line-height:1.8;border-radius:0}.member-tabs button::after{border:0}.member-tabs .is-active{color:#111;font-weight:600;border-bottom:4rpx solid #111}
.member-panel{padding-bottom:12rpx}.member-panel__title{font-size:30rpx;font-weight:600;margin:28rpx 0 8rpx}.member-hint{font-size:24rpx;color:#707070;line-height:1.8;margin:16rpx 0 24rpx}.wallet-filters{display:flex;gap:16rpx;margin-bottom:24rpx}.wallet-filters button{margin:0;padding:14rpx 22rpx;background:#fff;color:#707070;font-size:24rpx;line-height:1.8;border-radius:10rpx;min-height:88rpx}.wallet-filters .is-active{background:#f2f2f2;color:#111;font-weight:600}.wallet-filters button::after{border:0}
.coupon{padding:26rpx;margin:18rpx 0;background:#fff;border-radius:16rpx;border:1rpx solid #e9e9e7}.coupon__head{display:flex;align-items:center;gap:22rpx}.coupon__value{flex-shrink:0;min-width:84rpx;font-size:60rpx;font-weight:650;line-height:1.3}.coupon__value>text{font-size:26rpx;margin-right:4rpx}.coupon__body{min-width:0}.coupon__title{font-size:29rpx;font-weight:600;line-height:1.55;overflow-wrap:break-word}.coupon__threshold{font-size:25rpx;line-height:1.7;margin-top:6rpx}.coupon__meta{font-size:23rpx;color:#707070;line-height:1.7;margin-top:12rpx}.coupon__footer{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16rpx;border-top:1rpx dashed #d6d6d6;margin-top:22rpx;padding-top:20rpx;font-size:24rpx;line-height:1.7}.coupon__footer>text{flex:1;min-width:100rpx}.coupon__footer button{flex-shrink:0;min-height:88rpx;max-width:100%;margin:0;padding:15rpx 26rpx;border-radius:10rpx;background:#111;color:#fff;font-size:25rpx;line-height:1.9}.coupon__footer button::after{border:0}.coupon__footer button[disabled]{background:#e3e3e3;color:#707070}.coupon--muted .coupon__value{color:#707070}.coupon__status{font-weight:500}.points-price{font-weight:600}
.member-empty{padding:38rpx 24rpx;margin:20rpx 0;background:#f6f6f6;border-radius:18rpx;text-align:center}.member-empty>view{font-size:29rpx;font-weight:600;line-height:1.7}.member-empty>text{display:block;font-size:25rpx;color:#707070;line-height:1.8;margin:14rpx 0}.member-empty button{margin-top:24rpx;font-size:26rpx;min-height:88rpx}
button.member-disclosure{width:100%!important;display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:24rpx 0 0;padding:24rpx 0;min-height:92rpx;box-sizing:border-box;background:transparent;color:#111;font-size:27rpx;line-height:1.7;border-top:1rpx solid #e8e8e8;border-radius:0;text-align:left}.member-disclosure>text+text{font-size:24rpx;color:#707070}.member-disclosure::after{border:0}.member-disclosure--rules{margin-top:28rpx}.member-rules{padding:12rpx 0 24rpx;color:#707070;font-size:24rpx;line-height:1.9}.member-rules>text{display:block;margin-top:20rpx}.member-benefit{padding:10rpx 0}.points-entry{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx;padding:22rpx 0;border-bottom:1rpx solid #eee;font-size:25rpx;line-height:1.65}.points-entry__body{flex:1;min-width:0}.points-entry__body>text{display:block;margin-top:8rpx;color:#707070;font-size:23rpx}.points-entry__delta{font-weight:600;flex-shrink:0}.member-more{min-height:88rpx;background:transparent;font-size:25rpx;color:#111}.member-more::after{border:0}
.member-join{padding:28rpx 0}.member-join label{display:flex;align-items:flex-start;gap:12rpx;font-size:25rpx;line-height:1.8;margin-bottom:22rpx}.member-join checkbox{flex-shrink:0;transform:scale(.85);transform-origin:top left}.member-notice{padding:22rpx 24rpx;background:#f1f4ee;color:#263923;font-size:26rpx;line-height:1.8;border-radius:14rpx;margin:16rpx 0}.member-error{padding:22rpx;background:#faf0e8;color:#8c4134;font-size:25rpx;line-height:1.8;border-radius:14rpx;margin-bottom:22rpx}.member-error button{display:flex;align-items:center;justify-content:center;width:100%!important;margin:16rpx 0 0!important;padding:20rpx 24rpx;background:#fff;color:#8c4134;font-size:25rpx;font-weight:600;line-height:1.4;min-height:88rpx;border-radius:12rpx}.member-refresh{font-size:24rpx;color:#707070;line-height:1.8;margin:12rpx 0}.member-checkout-return{margin-top:28rpx}.member-actions{margin-top:24rpx}

.member-tabs{position:sticky;top:0;z-index:10;background:#fff;padding:6rpx;border:0;border-radius:12rpx;margin:18rpx 0}.member-tabs button{width:auto!important;min-width:0;min-height:80rpx;padding:18rpx 0;font-size:26rpx;line-height:1.6;border-radius:8rpx}.member-tabs button.is-active{border:0;background:#f0f0ee}.wallet-filters{gap:12rpx;margin:20rpx 0}.wallet-filters button{width:auto!important;flex:1;min-height:74rpx;font-size:23rpx;padding:14rpx 8rpx;background:transparent}.wallet-filters button.is-active{background:#e9e9e6}.member-summary{padding:24rpx}.member-summary__head{margin-top:10rpx}.member-summary__title{font-size:29rpx}.member-summary__stats{margin-top:18rpx}.member-summary__stats button{min-height:100rpx;font-size:23rpx}.member-summary__number{font-size:38rpx}.member-summary__copy{padding:14rpx 0 4rpx}.member-join{background:#fff;border-radius:16rpx;margin-top:18rpx;padding:24rpx}.member-rules{padding:24rpx;background:#fff;border-radius:12rpx;margin-top:12rpx}.coupon__value{font-size:52rpx}.coupon__title{font-size:27rpx}.coupon__threshold{font-size:23rpx}.coupon__footer button{width:auto!important;min-height:80rpx;padding:14rpx 22rpx;border-radius:10rpx;font-size:24rpx}.checkout-return{display:flex;align-items:center;gap:16rpx;background:#fff;padding:20rpx 24rpx;border-radius:12rpx;margin-bottom:18rpx;font-size:23rpx;color:#777;line-height:1.7}.checkout-return>text{flex:1}.checkout-return>button{width:auto!important;margin:0!important;padding:12rpx 0;background:none;font-size:24rpx;line-height:1.6;flex-shrink:0;color:#111}.points-entry{background:#fff;padding:22rpx}.member-empty button{max-width:420rpx;margin-left:auto!important;margin-right:auto!important}

.gift-entry{font-size:25rpx;text-align:left;padding:22rpx 0;margin:0 0 24rpx;background:transparent;border-radius:0;border-bottom:1rpx solid #e8e8e8}.gift-entry::after{border:0}

.member-newcomer{padding:30rpx;margin:24rpx 0;border:1rpx solid #e6e3dd;border-radius:16rpx;background:#f5f3ef}.member-newcomer__title{font-size:29rpx;font-weight:600;line-height:1.5}.member-newcomer__benefit{font-size:39rpx;line-height:1.7;font-weight:600;margin-top:8rpx}.member-newcomer__benefit text{font-size:29rpx;font-weight:500}.member-newcomer__note{font-size:23rpx;color:#777;line-height:1.8;margin-top:12rpx}.member-newcomer>.primary-button{margin-top:24rpx!important;border-radius:999rpx;font-size:27rpx}

.member-summary__stats button{flex-direction:column}.gift-entry{justify-content:flex-start}

.member-promotions{padding:22rpx 24rpx;margin:18rpx 0;background:#f7f5f1;border:1rpx solid #e8e3da;border-radius:12rpx;font-size:24rpx;line-height:1.8;color:#555}.member-promotions__title{font-size:28rpx;font-weight:600;color:#111;margin-bottom:8rpx}.member-promotions text{display:block;font-size:22rpx;color:#777;margin-top:8rpx}
