<page-meta page-style="{{specOpen || detailSheetOpen || priceSheetOpen ? 'overflow: hidden;' : ''}}"/>
<view wx:if="{{!isTimelinePreview}}" class="product-return" style="top:{{backTop}}px"><button class="product-return__button vk-button-content" bindtap="goBack" aria-label="返回"><view class="product-return__disc"><image src="/assets/icons/arrow-left.png"/></view></button></view>
<view wx:if="{{sectionNavVisible && !isTimelinePreview}}" class="product-safe-top" style="height:{{headerHeight}}px"/>
<view wx:if="{{!product}}" class="product-state" style="padding-top:{{headerHeight}}px"><brand-loader wx:if="{{loading}}" label="正在加载商品…"/><view wx:if="{{error}}" class="error-panel"><view>{{error}}</view><button class="error-panel__button vk-button-content" bindtap="retry">重新加载</button></view></view>
<block wx:if="{{product}}">
 <view class="gallery-wrap" id="product-overview">
  <swiper id="product-gallery-frame" current="{{galleryIndex}}" bindchange="onGalleryChange" style="height:{{galleryHeight}}rpx" class="gallery {{galleryMedia[galleryIndex].type==='video'?'gallery--video':''}} media-frame">
   <swiper-item wx:for="{{galleryMedia}}" wx:key="id" class="gallery-slide">
    <block wx:if="{{item.type==='image'}}">
     <image wx:if="{{!mediaRetrying[item.source] && (index === galleryIndex || index === galleryIndex - 1 || index === galleryIndex + 1)}}" class="gallery-image media-image {{mediaLoaded[item.source] ? 'media-image--ready' : ''}}" src="{{item.source}}" mode="aspectFit" data-src="{{item.source}}" data-source="{{item.source}}" bindload="onMediaLoad" binderror="onMediaError" bindtap="previewImage"/>
     <brand-loader wx:if="{{index===galleryIndex && galleryImageLoading===item.source && !mediaFailed[item.source]}}" overlay compact label="正在加载图片…"/>
     <view wx:if="{{mediaFailed[item.source]}}" class="media-fallback"><text>图片暂时未能加载</text><button class="vk-button-content" data-source="{{item.source}}" catchtap="onMediaRetry">重新加载图片</button></view>
    </block>
    <view wx:else class="product-film product-film--gallery">
     <block wx:if="{{activeVideoId==='product-gallery-video' && index===galleryIndex}}"><video id="product-gallery-video" class="product-film__video" src="{{item.source}}" poster="{{item.poster}}" autoplay="{{true}}" loop="{{true}}" muted="{{true}}" controls="{{true}}" show-center-play-btn="{{false}}" show-mute-btn="{{true}}" show-fullscreen-btn="{{true}}" object-fit="contain" bindplay="onProductVideoReady" bindwaiting="onProductVideoWaiting" bindtimeupdate="onProductVideoReady" bindended="onProductVideoEnded" binderror="onProductVideoError" aria-label="{{item.title}}"/><brand-loader wx:if="{{videoLoadingId==='product-gallery-video'}}" overlay compact label="正在加载影片…"/></block>
     <block wx:else><image class="product-film__poster" src="{{item.poster}}" mode="aspectFit"/><button wx:if="{{videoFailures['product-gallery-video']}}" class="product-film__retry vk-button-content" data-video-id="product-gallery-video" bindtap="playProductVideo">影片加载失败，重试</button></block>
    </view>
   </swiper-item>
  </swiper>
  <view class="gallery-toolbar"><scroll-view scroll-x class="gallery-thumbs" enhanced show-scrollbar="{{false}}" scroll-into-view="gallery-thumb-{{galleryIndex}}" scroll-with-animation><view class="thumb-track"><button wx:for="{{galleryMedia}}" wx:key="id" id="gallery-thumb-{{index}}" data-index="{{index}}" bindtap="chooseImage" class="thumb {{galleryIndex===index?'thumb--active':''}} {{item.type==='video'?'thumb--video':''}} vk-button-content" aria-label="{{item.type==='video'?'查看产品影片':item.title}}" aria-pressed="{{galleryIndex===index}}"><image src="{{item.type==='video'?item.poster:item.thumbnail}}" mode="aspectFit"/><text wx:if="{{item.type==='video'}}" class="thumb__video-label">▶ 视频</text></button></view></scroll-view><view class="gallery-count">{{galleryIndex + 1}} / {{galleryMedia.length}}</view></view>
 </view>

 <share-entry wx:if="{{isTimelinePreview}}" single-page/>
 <view wx:if="{{catalogNotice}}" class="catalog-notice">{{catalogNotice}}</view>
 <view wx:if="{{error}}" class="error-panel"><view>{{error}}</view><button class="error-panel__button vk-button-content" bindtap="retry">重新加载</button></view>
 <view wx:if="{{sectionNavVisible}}" class="product-nav" style="top:{{headerHeight}}px" role="tablist"><button id="nav-overview" data-section="overview" bindtap="jumpToSection" class="product-nav__tab {{activeSection==='overview'?'product-nav__tab--active':''}} vk-button-content" aria-selected="{{activeSection==='overview'}}">商品</button><button id="nav-size" data-section="size" bindtap="jumpToSection" class="product-nav__tab {{activeSection==='size'?'product-nav__tab--active':''}} vk-button-content" aria-selected="{{activeSection==='size'}}">尺码</button><button id="nav-details" data-section="details" bindtap="jumpToSection" class="product-nav__tab {{activeSection==='details'?'product-nav__tab--active':''}} vk-button-content" aria-selected="{{activeSection==='details'}}">详情</button></view>
 <view class="detail">
  <view class="product-intro" id="product-intro">
   <view class="product-intro__top"><view class="detail-brand">MerchantKit / X-SERIES</view><view class="public-share-entry"><share-entry id="page-share-entry" wx:if="{{!isTimelinePreview}}" source="{{product.image}}" bind:coverready="onShareCoverReady"/></view></view>
   <view class="title">{{product.slug==='x1-air-white'?'X1 Air':product.displayName}}</view><view class="subtitle">{{product.subtitle}}</view>
   <view class="product-price-line"><view class="price" wx:if="{{product.showPrice}}">{{stylePriceLabel}}<text> / 条</text></view><view class="product-release">{{product.releaseLabel}}</view></view>
   <view class="product-price-note">{{selectedStyleLabel}} · 白色 · {{selectedSize}} 码</view>
   <button wx:if="{{product.showPrice && priceView}}" id="open-price-details" class="product-price-preview {{priceView.hasSaving?'product-price-preview--saving':''}} vk-button-content" bindtap="openPriceDetails" aria-label="查看预估价明细"><view class="price-preview__amount"><text>{{priceView.payableLabel}}</text><text>商品预估</text></view><view class="price-preview__copy"><view>{{priceView.strategyLabel}}</view><text>{{priceView.summaryDetail}}</text></view><image src="/assets/icons/chevron-right.png"/></button>
   <button class="product-details-link vk-button-content" id="view-product-details" bindtap="openProductDetails"><text>查看产品细节</text><text>＋</text></button>
  </view>
  <view class="purchase-module purchase-module--rows">
   <button class="purchase-option-row vk-button-content" id="open-style-selection" bindtap="openSpecs"><text>款式</text><view>{{selectedStyleLabel}}<image src="/assets/icons/chevron-right.png"/></view></button>
   <button class="purchase-option-row vk-button-content" id="open-specs" bindtap="openSpecs"><text>尺码 / 数量</text><view>{{selectedSize}} 码 · {{quantity}} 条<image src="/assets/icons/chevron-right.png"/></view></button>
   <button class="purchase-option-row purchase-option-row--delivery vk-button-content" bindtap="openDelivery"><view><text>发货安排</text><view>{{product.shipLabel || '查看配送与运费说明'}}</view></view><image src="/assets/icons/chevron-right.png"/></button>
  </view>
  <view class="size-section" id="product-size"><view class="section-eyebrow">FIND YOUR FIT</view><view class="section-heading"><text>尺码与穿着</text><button class="vk-button-content" bindtap="openSpecs">选尺码<image src="/assets/icons/chevron-right.png"/></button></view><view class="fit-note" wx:if="{{product.fitNote}}">{{product.fitNote}}</view>
   <view wx:if="{{guideLoading}}" class="guide-state">正在加载尺码指南…</view><view wx:if="{{guideError}}" class="guide-state"><text>{{guideError}}</text><button class="vk-button-content" bindtap="loadGuide">重新加载</button></view>
   <view class="fit-tips"><view class="fit-tip" wx:for="{{guideTips}}" wx:key="id"><view>{{item.title}}</view><text>{{item.body}}</text></view></view>
   <button class="size-link vk-button-content" bindtap="openGuide">查看完整尺码指南<image src="/assets/icons/chevron-right.png"/></button>
  </view>
  <view class="description" id="product-details">
   <view class="section-eyebrow">MADE FOR EVERYDAY</view>
   <view class="detail-media-heading">细节与工艺</view><view class="description-copy">{{product.summary}}</view>
   <view wx:if="{{productFilm}}" class="detail-film"><view class="product-film__heading"><text>30秒，了解 X1 Air</text><text>产品影片</text></view><view id="product-detail-film" class="product-film product-film--detail"><block wx:if="{{activeVideoId==='product-detail-video'}}"><video id="product-detail-video" class="product-film__video" src="{{productFilm.source}}" poster="{{productFilm.poster}}" autoplay="{{true}}" loop="{{true}}" muted="{{true}}" controls="{{true}}" show-center-play-btn="{{false}}" show-mute-btn="{{true}}" show-fullscreen-btn="{{true}}" object-fit="contain" bindplay="onProductVideoReady" bindwaiting="onProductVideoWaiting" bindtimeupdate="onProductVideoReady" bindended="onProductVideoEnded" binderror="onProductVideoError" aria-label="{{productFilm.title}}"/><brand-loader wx:if="{{videoLoadingId==='product-detail-video'}}" overlay compact label="正在加载影片…"/></block><block wx:else><image class="product-film__poster" src="{{productFilm.poster}}" mode="aspectFit"/><button wx:if="{{videoFailures['product-detail-video']}}" class="product-film__retry vk-button-content" data-video-id="product-detail-video" bindtap="playProductVideo">影片加载失败，重试</button></block></view><text class="product-film__note">自动静音播放，可在播放器中开启声音或全屏观看。</text></view>
   <block wx:if="{{commonDetailMedia.length}}">
    <view class="detail-artwork" wx:for="{{commonDetailMedia}}" wx:key="id"><view class="detail-artwork__frame" style="padding-top:{{item.aspectPercent}}%"><image wx:if="{{!mediaRetrying[item.imageUrl]}}" class="detail-artwork__image" src="{{item.imageUrl}}" mode="aspectFit" lazy-load data-src="{{item.previewUrl}}" data-source="{{item.imageUrl}}" bindtap="previewDetailImage" bindload="onMediaLoad" binderror="onMediaError"/><view wx:if="{{mediaFailed[item.imageUrl]}}" class="media-fallback"><text>图片暂时未能加载</text><button class="vk-button-content" data-source="{{item.imageUrl}}" catchtap="onMediaRetry">重新加载图片</button></view></view><view class="detail-artwork__caption {{item.detail ? 'detail-artwork__caption--detailed' : ''}}"><block wx:if="{{item.detail}}"><view class="detail-artwork__heading"><text class="detail-artwork__number">{{item.detail.number}}</text><text>{{item.detail.title}}</text></view><view class="detail-artwork__body">{{item.detail.body}}</view></block><text wx:else>{{item.title}}</text></view></view>
    <view wx:if="{{styleDetailMedia.length}}" class="detail-gusset"><view class="detail-media-heading">升级款 · 裆部升级</view><view class="detail-gusset__note">莫代尔与新疆柔棉材质、10A级别抗菌处理仅用于升级款裆部，主体面料与常规款相同。</view><view class="detail-artwork" wx:for="{{styleDetailMedia}}" wx:key="id"><view class="detail-artwork__frame" style="padding-top:{{item.aspectPercent}}%"><image wx:if="{{!mediaRetrying[item.imageUrl]}}" class="detail-artwork__image" src="{{item.imageUrl}}" mode="aspectFit" lazy-load data-src="{{item.previewUrl}}" data-source="{{item.imageUrl}}" bindtap="previewDetailImage" bindload="onMediaLoad" binderror="onMediaError"/><view wx:if="{{mediaFailed[item.imageUrl]}}" class="media-fallback"><text>图片暂时未能加载</text><button class="vk-button-content" data-source="{{item.imageUrl}}" catchtap="onMediaRetry">重新加载图片</button></view></view><view class="detail-artwork__caption {{item.detail ? 'detail-artwork__caption--detailed' : ''}}"><block wx:if="{{item.detail}}"><view class="detail-artwork__heading"><text class="detail-artwork__number">{{item.detail.number}}</text><text>{{item.detail.title}}</text></view><view class="detail-artwork__body">{{item.detail.body}}</view></block><text wx:else>{{item.title}}</text></view></view></view>
   </block>
   <block wx:else><image wx:for="{{product.images}}" wx:key="*this" wx:if="{{index>1}}" src="{{item}}" mode="widthFix" lazy-load/></block>
   <button wx:if="{{product.careInstructions}}" class="detail-disclosure detail-disclosure--care vk-button-content" data-section="careOpen" bindtap="toggleSection" aria-expanded="{{careOpen}}"><text>洗护建议</text><text class="detail-disclosure__mark">{{careOpen?'−':'+'}}</text></button>
   <view wx:if="{{careOpen && product.careInstructions}}" class="description-copy care-copy">{{product.careInstructions}}</view>
   <button class="delivery-link vk-button-content" bindtap="openDelivery">配送与预售说明<image src="/assets/icons/chevron-right.png"/></button>
   <button class="help-link vk-button-content" bindtap="openContact">帮助与客服<image src="/assets/icons/chevron-right.png"/></button>
  </view>
 </view>
 <view wx:if="{{!isTimelinePreview}}" class="purchase-bar">
  <view wx:if="{{added}}" class="purchase-feedback" role="status"><view><image src="/assets/icons/check.png"/><text>已加入 · {{addedLabel}}</text></view><button class="vk-button-content" bindtap="openBag">查看购物袋</button></view>
  <view class="purchase-actions"><view class="purchase-service"><service-contact id="product-contact" mode="toolbar" scene="product" slug="{{product.slug}}" style-key="{{selectedStyle}}" product-name="{{product.displayName}}" image="{{product.image}}"/></view><button class="bag-button vk-button-content" bindtap="openBag" aria-label="查看购物袋"><image src="/assets/icons/shopping-bag.png"/><text>购物袋</text></button><button wx:if="{{editingCartItem}}" class="primary-button add-button vk-button-content" bindtap="beginAddToBag" disabled="{{adding || specClosing || !product.isPurchasable || !variant || variant.soldOut}}">修改规格</button><block wx:else><button id="product-add-to-bag" class="secondary-button add-to-bag-button vk-button-content" bindtap="beginAddToBag" disabled="{{adding || specClosing || !product.isPurchasable || !variant || variant.soldOut}}" hover-class="vk-pressed">加入购物袋</button><button id="product-buy-now" class="primary-button buy-now-button vk-button-content" bindtap="beginBuyNow" disabled="{{adding || specClosing || !product.isPurchasable || !variant || variant.soldOut}}" hover-class="vk-pressed">立即购买</button></block></view>
 </view>
 <view wx:if="{{specOpen}}" class="spec-overlay {{specClosing ? 'spec-overlay--closing' : ''}}">
  <view class="spec-backdrop" catchtap="closeSpecs" catchtouchmove="stopSheet"/>
  <view class="spec-sheet {{specClosing ? 'spec-sheet--closing' : ''}}" catchtap="stopSheet">
   <view class="spec-sheet__head"><image class="spec-product-image" src="{{selectionImage || product.bagImage || product.image}}" mode="aspectFit"/><view class="spec-heading"><view class="spec-sheet__title">{{guideOpen?'尺码指南':'选择款式与尺码'}}</view><view wx:if="{{!guideOpen}}" class="spec-head-price">{{totalLabel}}<text>{{unitLabel}}</text></view><text>{{selectionLabel}}</text></view><button class="sheet-close vk-button-content" bindtap="closeSpecs" aria-label="关闭规格选择"><image src="/assets/icons/close.png"/></button></view>
   <view class="spec-sheet__body-wrap">
   <scroll-view scroll-y class="spec-sheet__body" scroll-into-view="{{specScrollTarget}}" show-scrollbar enhanced bounces="{{false}}">
    <block wx:if="{{guideOpen}}"><view class="guide-panel" id="spec-guide-start"><fit-assistant id="fit-guide-assistant" selectable sizes="{{sizes}}" bindselect="applyFitSize"/><view wx:if="{{guideLoading}}" class="guide-state">正在加载测量方法…</view><view wx:if="{{guideError}}" class="guide-state"><view>{{guideError}}</view><button class="secondary-button vk-button-content" bindtap="openGuide">重新加载</button></view><view class="guide-tip" wx:for="{{guideTips}}" wx:key="id"><view class="guide-tip__title">{{item.title}}</view><view>{{item.body}}</view></view></view></block>
    <block wx:else>
     <view id="spec-selection-start"/>
     <view wx:if="{{styles.length}}" class="option"><view class="option-heading"><text>款式 · 白色</text><button class="vk-button-content" id="spec-style-details" bindtap="openProductDetails">查看款式细节<image src="/assets/icons/chevron-right.png"/></button></view><view class="style-options"><button wx:for="{{styles}}" wx:key="key" id="style-{{item.key}}" data-style="{{item.key}}" bindtap="chooseStyle" disabled="{{adding}}" aria-label="{{item.label}}，{{item.priceLabel}}一条" aria-pressed="{{item.selected}}" class="style-choice {{item.selected?'style-choice--selected':''}} vk-button-content"><view class="style-choice__info"><view class="style-choice__top">{{item.label}}</view><view class="style-choice__summary">{{item.summary}}</view></view><view class="style-choice__price">{{item.priceLabel}}<text> / 条</text></view><text class="style-radio">{{item.selected?'✓':''}}</text></button></view></view>
     <view class="option" id="spec-size-options"><view class="option-heading"><text>尺码</text><button class="vk-button-content" id="sheet-guide" bindtap="openGuide">尺码助手<image src="/assets/icons/chevron-right.png"/></button></view><view class="options size-options"><button wx:for="{{sizes}}" wx:key="size" id="size-{{item.size}}" class="choice {{item.selected?'choice--selected':''}} vk-button-content" disabled="{{item.disabled || adding}}" data-size="{{item.size}}" data-disabled="{{item.disabled}}" hover-class="choice--pressed" aria-label="{{item.size}}码，{{item.disabled?'不可选':(item.selected?'已选中':'未选中')}}" bindtap="chooseSize">{{item.size}}<text wx:if="{{item.disabled}}" class="sold-out-label">缺货</text></button></view><view class="selected-fit" role="status"><view class="selected-fit__heading">已选 {{selectedSize}} 码<text wx:if="{{product.fitNote}}"> · {{product.fitNote}}</text></view><view class="selected-fit__measurement" wx:for="{{sizeMeasurements}}" wx:key="label"><text>{{item.label}}</text><text>{{item.value}}</text></view><text wx:if="{{!sizeMeasurements.length}}" class="selected-fit__hint">请按腰头穿着位置测量腰围，再参考尺码指南。</text><button class="vk-button-content" wx:if="{{guideError}}" bindtap="loadGuide">重新加载尺码说明</button></view></view>
     <view class="option"><view class="option-heading"><text>选择数量</text><text class="option-hint">按所选款式计价</text></view><view class="quantity-picker"><view class="quantity-picker__control"><button class="vk-button-content" id="quantity-minus" aria-label="减少数量" data-delta="-1" bindtap="changeQuantity" disabled="{{adding || quantity<=1}}">−</button><input id="quantity-input" type="number" aria-label="购买数量" value="{{quantity}}" maxlength="2" bindblur="inputQuantity" bindconfirm="inputQuantity" disabled="{{adding}}"/><button class="vk-button-content" id="quantity-plus" aria-label="增加数量" data-delta="1" bindtap="changeQuantity" disabled="{{adding || quantity>=quantityLimit}}">+</button></view><text>条</text></view><view class="quantity-hint">{{quantityHint}}</view><view class="options pack-options"><button wx:for="{{packs}}" wx:key="quantity" id="pack-{{item.quantity}}" class="choice pack-choice {{item.selected?'choice--selected':''}} vk-button-content" disabled="{{item.disabled || adding}}" data-quantity="{{item.quantity}}" data-disabled="{{item.disabled}}" hover-class="choice--pressed" aria-label="{{item.label}}，{{item.disabled?'不可选':(item.selected?'已选中':'未选中')}}" bindtap="choosePack"><text class="pack-count">{{item.quantity}} 条</text><text class="pack-price">{{item.priceLabel}}</text></button></view><view class="pack-receipt"><text>{{unitLabel}}</text><text wx:if="{{savingLabel}}">{{savingLabel}}</text></view></view>
     <button wx:if="{{product.showPrice && priceView}}" id="spec-price-details" class="spec-price-entry vk-button-content" bindtap="openPriceDetails"><text>商品预估 {{priceView.payableLabel}}</text><view>价格明细<image src="/assets/icons/chevron-right.png"/></view></button>
     <view class="spec-shipping" wx:if="{{product.shipLabel}}">{{product.shipLabel}}</view>
    </block>
   </scroll-view>
   </view>
   <view class="spec-sheet__footer"><button wx:if="{{guideOpen}}" class="primary-button vk-button-content" bindtap="closeGuide">返回尺码选择</button><block wx:else><view class="spec-total"><view class="spec-total__summary"><text>商品合计</text><text class="spec-total__price">{{totalLabel}}</text></view><view class="spec-total__saving">{{savingLabel}}</view></view><button wx:if="{{!isTimelinePreview}}" class="primary-button vk-button-content" id="confirm-product-selection" bindtap="confirmPurchase" loading="{{adding}}" disabled="{{adding || specClosing || !product.isPurchasable || !variant || variant.soldOut}}">{{editingCartItem?'确认更新':(purchaseIntent==='buy'?'确认并结算':'加入购物袋')}}</button></block></view>
  </view>
 </view>
 <view wx:if="{{detailSheetOpen}}" class="details-overlay">
  <view class="details-backdrop" catchtap="closeProductDetails" catchtouchmove="stopSheet"/>
  <view class="details-sheet" role="dialog" aria-label="产品细节">
   <view class="details-sheet__head"><view><view class="details-sheet__title">产品细节</view><view class="details-sheet__selection">{{selectedStyleLabel}} · 白色</view></view><button id="close-product-details" class="details-close vk-button-content" bindtap="closeProductDetails" aria-label="关闭产品细节"><image src="/assets/icons/close.png"/></button></view>
   <scroll-view id="product-details-scroll" class="details-sheet__scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="details-sheet__content"><view class="details-sheet__intro">{{product.summary || product.subtitle}}</view><view class="numbered-detail" wx:for="{{detailSections}}" wx:key="number"><view class="numbered-detail__title"><text class="numbered-detail__number">{{item.number}}</text><text>{{item.title}}</text></view><view class="numbered-detail__body">{{item.body}}</view></view><view wx:if="{{!detailSections.length}}" class="numbered-detail__body">{{product.description}}</view><view wx:if="{{product.slug==='x1-air-white'}}" class="details-sheet__end">{{selectedStyle==='upgraded'?'材质说明仅适用于升级款裆部。主体面料与常规款相同。':'常规款与升级款的区别在裆部材质，主体面料相同。'}}</view></view>
   </scroll-view>
   <view class="details-sheet__footer"><button id="details-to-shop" class="primary-button vk-button-content" bindtap="shopFromDetails">选尺码与数量</button></view>
  </view>
 </view>

 <view wx:if="{{priceSheetOpen && priceView}}" class="price-overlay">
  <view class="price-backdrop" catchtap="closePriceDetails" catchtouchmove="stopSheet"/>
  <view class="price-sheet" role="dialog" aria-label="预估价明细">
   <view class="price-sheet__head"><view><view class="price-sheet__title">预估价明细</view><text>{{selectionLabel}}</text></view><button id="close-price-details" class="price-sheet__close vk-button-content" bindtap="closePriceDetails" aria-label="关闭价格明细"><image src="/assets/icons/chevron-right.png"/></button></view>
   <view class="price-sheet__body-wrap"><scroll-view id="price-details-scroll" class="price-sheet__scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="price-sheet__content">
     <view class="price-calculation"><view class="price-calculation__caption">当前选购价格</view><view class="price-equation"><view class="price-equation__item"><text>单条合计</text><view>{{priceView.subtotalLabel}}</view></view><text class="price-equation__symbol">−</text><view class="price-equation__item"><text>{{priceView.discountTitle}}</text><view>{{priceView.discountLabel}}</view></view><text class="price-equation__symbol">=</text><view class="price-equation__item price-equation__result"><text>商品预估</text><view>{{priceView.payableLabel}}</view></view></view><view class="price-calculation__note">{{priceView.strategyNote}}</view></view>
     <view wx:if="{{priceView.couponTitle}}" class="price-coupon-used"><text>本次预估使用</text><view>{{priceView.couponTitle}}</view></view>
     <view wx:if="{{priceView.bundles.length}}" class="price-bundle-list"><view class="price-section-title">组合价拆分</view><view wx:for="{{priceView.bundles}}" wx:key="label"><text>{{item.label}}</text><text>{{item.amountLabel}}</text></view></view>
     <view wx:if="{{!isTimelinePreview}}" class="price-wallet"><view><text>{{priceView.walletMessage}}</text><button class="vk-button-content" wx:if="{{priceWalletStatus==='error'}}" bindtap="loadPriceWallet">重新同步</button></view><button class="vk-button-content" id="price-view-wallet" bindtap="openPriceWallet">查看我的券<image src="/assets/icons/chevron-right.png"/></button></view>
     <view class="price-estimate-note">仅预估当前所选商品，未含运费；加入购物袋后，会按全部商品重新计算，最终金额以结算页为准。</view>
     <button id="price-rules-toggle" class="price-rules-toggle vk-button-content" bindtap="togglePriceRules" aria-expanded="{{priceRulesOpen}}"><text>价格如何计算</text><image src="/assets/icons/chevron-right.png" class="{{priceRulesOpen?'price-rules-open':''}}"/></button>
     <view wx:if="{{priceRulesOpen}}" class="price-rules"><view>按当前款式的单条售价与选购数量计算“单条合计”。</view><view>组合价与优惠券自动择优，不叠加；优惠相同时保留优惠券。</view><view wx:if="{{product.quantityPricing.repeatBundles}}">两条起按现有组合价计价，超过四条自动拆分为最省组合。</view><view>仅已领取、在有效期内且满足商品及金额条件的优惠券计入预估。未领取的券不提前扣减。</view><view>运费在结算页按收货地址计算，优惠券不抵扣运费。</view></view>
    </view>
   </scroll-view></view>
   <view class="price-sheet__footer"><button id="price-select-specs" class="primary-button vk-button-content" bindtap="selectFromPriceDetails">{{specOpen?'返回选购':'选择尺码与数量'}}</button></view>
  </view>
 </view>
</block>
<privacy-sheet id="privacy-sheet"/>
