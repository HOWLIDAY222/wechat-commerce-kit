.member-profile-page{min-height:100vh;background:#f5f5f5;color:#111111}
.member-cover{position:relative;box-sizing:border-box;width:100%;min-height:0;padding-bottom:28rpx;background:#f5f5f5;overflow:hidden}
.member-cover__copy{display:flex;align-items:center;min-height:100rpx;position:relative;margin:0 36rpx;font-size:38rpx;line-height:1.5;letter-spacing:1rpx}
.member-nav{position:absolute;left:24rpx;right:24rpx;height:44px;display:flex;align-items:center;pointer-events:none}
.member-back{width:76rpx!important;height:76rpx;margin:0!important;padding:20rpx;background:rgba(255,255,255,.82);border-radius:24rpx;pointer-events:auto;display:flex;align-items:center;justify-content:center}
.member-back image{width:36rpx;height:36rpx}
.member-identity{position:relative;margin:0 28rpx 26rpx;padding:28rpx 28rpx 30rpx;border-top:1rpx solid #e3e3e3;text-align:left}
.member-identity__wordmark{width:226rpx;height:36rpx;margin-bottom:20rpx;opacity:.8}
.member-identity__name{display:flex;align-items:center;justify-content:flex-start;gap:16rpx;background:none;font-size:32rpx;font-weight:500;line-height:1.5;padding:0;margin:0!important;max-width:100%;width:auto!important;white-space:normal;overflow-wrap:anywhere;text-align:left}
.member-identity__name[disabled]{background:none!important;color:#111111!important}
.member-identity__edit{font-size:22rpx;color:#777777;flex-shrink:0;font-weight:400;border-bottom:1rpx solid #aaaaaa}
.member-form{padding:0 28rpx}
.member-field{box-sizing:border-box;margin-bottom:24rpx;min-width:0;padding:28rpx 28rpx 30rpx;background:#fff;border-radius:16rpx}
.member-label{display:flex;align-items:center;justify-content:space-between;min-height:42rpx;margin-bottom:12rpx;font-size:26rpx;color:#111111;line-height:1.6}
.member-label text,.member-subscriptions text{font-size:21rpx;color:#777777;font-weight:400;margin-left:8rpx}
.member-input{display:flex;align-items:center;box-sizing:border-box;width:100%;height:80rpx;min-height:80rpx;padding:0 18rpx;border:0;border-bottom:1rpx solid #e3e3e3;border-radius:0;background:#fff;font-size:27rpx;line-height:80rpx;color:#111111}
.member-input-button{justify-content:flex-start;width:100%!important;margin:0!important;text-align:left;font-weight:400}
.member-placeholder{color:#999999}
.member-name-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16rpx}
.member-name-grid .member-field{padding:22rpx 18rpx}
.member-picker{display:flex;align-items:center;justify-content:space-between;box-sizing:border-box;gap:20rpx;min-height:80rpx;padding:18rpx;border:0;border-bottom:1rpx solid #e3e3e3;font-size:27rpx;line-height:1.6}
.member-picker text{min-width:0;overflow-wrap:anywhere}
.member-picker--empty{color:#999999}
.member-picker__arrow{width:22rpx;height:22rpx;transform:rotate(90deg);opacity:.45;flex-shrink:0}
.member-phone{display:flex;align-items:stretch;gap:12rpx}
.member-phone__value{flex:1;min-width:0;font-size:25rpx}
.member-phone__bound{display:flex;align-items:center;padding:0 8rpx;font-size:22rpx;color:#777777;flex-shrink:0}
.member-clear{width:auto!important;margin:0!important;padding:8rpx 0 8rpx 20rpx;background:none;font-size:22rpx;color:#777777;line-height:1.5;border-radius:0}
.member-policy{display:flex;flex-wrap:wrap;gap:12rpx 16rpx;font-size:21rpx;color:#707070;line-height:1.8;margin:20rpx 10rpx}
.member-policy text{padding:4rpx 0;text-decoration:underline}
.member-subscriptions{display:flex;align-items:center;justify-content:space-between;gap:24rpx;width:100%!important;margin:26rpx 0 0!important;padding:26rpx 28rpx;background:#fff;border-radius:16rpx;text-align:left;font-size:26rpx;line-height:1.7;color:#111111}
.member-subscriptions>view{flex:1;min-width:0}
.member-subscriptions image{width:24rpx;height:24rpx;flex-shrink:0}
.member-feedback{margin:24rpx 28rpx;padding:22rpx 26rpx;background:#eeeeee;border-radius:14rpx;font-size:24rpx;line-height:1.8;color:#111111}
.member-feedback--error{background:#e6e6e6;color:#646464}
.member-retry{display:block;width:auto!important;margin:12rpx 0 0!important;padding:8rpx 0;background:none;color:inherit;font-size:24rpx;text-decoration:underline;line-height:1.7;border-radius:0}
.member-save-space{height:180rpx;height:calc(180rpx + env(safe-area-inset-bottom))}
.member-save{position:fixed;bottom:0;left:0;right:0;z-index:5;padding:22rpx 28rpx 28rpx;padding-bottom:calc(28rpx + env(safe-area-inset-bottom));background:rgba(245,245,245,.97);border-top:1rpx solid #e3e3e3}
.member-save__button{display:flex;align-items:center;justify-content:center;width:100%!important;min-height:92rpx;margin:0!important;padding:22rpx 24rpx;border-radius:18rpx;background:#111111;color:#fff;font-size:28rpx;line-height:1.5;letter-spacing:2rpx}
.member-save__button[disabled]{background:#d7d7d7!important;color:#909090!important}
.member-guest{margin:0 28rpx 48rpx;padding:30rpx 28rpx;background:#fff;border-radius:18rpx}
.member-guest__title{font-size:30rpx;font-weight:500;line-height:1.6}
.member-guest__copy{font-size:25rpx;color:#777777;line-height:1.9;margin:18rpx 0 30rpx}
.member-guest .primary-button{border-radius:16rpx;background:#111111;color:#fff}
.member-more{display:flex;align-items:center;justify-content:space-between;gap:24rpx;width:100%!important;margin:0 0 16rpx!important;padding:26rpx 28rpx;background:#e9e9e9;color:#111111;border-radius:16rpx;font-size:25rpx;line-height:1.6}
.member-more>text:last-child{font-size:22rpx;color:#777777}
.member-more-fields{padding-top:0}
.member-avatar-card{margin-bottom:28rpx;padding:30rpx 28rpx;background:#fff;border-radius:22rpx;box-shadow:0 6rpx 24rpx rgba(0,0,0,.025)}
.member-avatar-card__head{display:flex;align-items:center;gap:24rpx}
.member-avatar-preview{display:flex;align-items:center;justify-content:center;box-sizing:border-box;flex-shrink:0;width:112rpx!important;height:112rpx;margin:0!important;padding:0;border:0;border-radius:50%;overflow:hidden;background:#f0f0f0}
.member-avatar-preview image{width:100%;height:100%}
.member-avatar-preview image.member-avatar-preview__default{width:52rpx;height:52rpx;opacity:.6}
.member-avatar-card__title{font-size:29rpx;line-height:1.6;font-weight:500}
.member-avatar-card__title text{font-size:22rpx;font-weight:400;color:#777;margin-left:12rpx}
.member-avatar-card__hint{font-size:23rpx;line-height:1.7;color:#777;margin-top:10rpx}
.member-avatar-actions{display:flex;align-items:center;gap:20rpx;margin-top:26rpx}
.member-avatar-choose{width:auto!important;margin:0!important;padding:20rpx 32rpx;min-height:80rpx;background:#111;color:#fff;border-radius:16rpx;font-size:25rpx;line-height:1.6}
.member-avatar-choose[disabled]{background:#e7e7e7!important;color:#999!important}
.member-avatar-remove,.member-avatar-refresh{width:auto!important;margin:0!important;padding:20rpx 26rpx;min-height:80rpx;background:#f1f1f1;color:#333;border-radius:16rpx;font-size:25rpx;line-height:1.6}
.member-avatar-feedback{margin-top:20rpx;padding-top:20rpx;border-top:1rpx solid #eee;font-size:24rpx;line-height:1.8;color:#666}
.member-avatar-refresh{margin-top:16rpx!important;display:inline-flex}
