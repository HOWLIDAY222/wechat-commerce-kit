@import "../../common/service-guides.wxss";
.care-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx}.care-rule{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0;min-height:278rpx;padding:30rpx 24rpx;background:#f4f4f4;border:1rpx solid #f4f4f4;border-radius:22rpx;text-align:center}.care-rule--wash{background:#efeeec;border-color:#efeeec}.care-rule--dry{background:#fff;border-color:#dedede}.care-rule__temperature{font-size:62rpx;line-height:1.15;font-weight:500;letter-spacing:-2rpx;min-height:84rpx;display:flex;align-items:center}.care-rule__icon{width:80rpx;height:80rpx}.care-rule__text{font-size:29rpx;font-weight:500;line-height:1.7;margin-top:26rpx;overflow-wrap:anywhere}.care-label-note{padding:28rpx 4rpx 0;font-size:26rpx;line-height:1.8;color:#666}.care-sequence{padding:6rpx 26rpx;border:1rpx solid #e2e2e2;border-radius:22rpx}.care-sequence__step{display:flex;gap:24rpx;padding:32rpx 0;border-bottom:1rpx solid #ededed}.care-sequence__step:last-child{border-bottom:0}.care-sequence__index{display:flex;align-items:center;justify-content:center;flex:none;width:56rpx;height:56rpx;border-radius:50%;background:#1c1c1c;color:#fff;font-size:27rpx;line-height:1;margin-top:3rpx}.care-sequence__content{min-width:0}.care-sequence__title{font-size:31rpx;line-height:1.6;font-weight:500}.care-sequence__copy{font-size:28rpx;line-height:1.85;color:#555;margin-top:10rpx}@media(max-width:340px){.care-rule{padding:26rpx 18rpx;min-height:270rpx}.care-rule__text{font-size:29rpx}.care-rule__temperature{font-size:58rpx}}
