<brand-header back/>
<view class="operations-page social-page">
  <view class="operations-title">社媒任务</view>
  <view class="social-tabs">
    <button class="{{socialTab === 'share' && socialStage !== 'history' ? 'is-selected' : ''}}" data-tab="share" bindtap="changeSocialTab" disabled="{{busy || socialUploading}}">发帖</button>
    <button class="{{socialTab === 'interaction' && socialStage !== 'history' ? 'is-selected' : ''}}" data-tab="interaction" bindtap="changeSocialTab" disabled="{{busy || socialUploading}}">互动</button>
    <button class="{{socialTab === 'repost' && socialStage !== 'history' ? 'is-selected' : ''}}" data-tab="repost" bindtap="changeSocialTab" disabled="{{busy || socialUploading}}">转发</button>
    <button class="{{socialTab === 'follow' && socialStage !== 'history' ? 'is-selected' : ''}}" data-tab="follow" bindtap="changeSocialTab" disabled="{{busy || socialUploading}}">关注</button>
    <button class="{{socialStage === 'history' ? 'is-selected' : ''}}" data-tab="history" bindtap="changeSocialTab" disabled="{{busy || socialUploading}}">记录</button>
  </view>
  <brand-loader wx:if="{{loading && !overview}}" label="正在加载活动"/>
  <view wx:if="{{guest}}" class="social-card"><button class="operations-button" bindtap="goLogin">登录 / 注册</button></view>
  <view wx:if="{{error}}" class="operations-status operations-status--error"><view>{{error}}</view><button wx:if="{{syncFailed}}" class="operations-link" bindtap="loadOperations" disabled="{{busy || socialUploading}}">刷新记录</button></view>
  <view wx:if="{{notice}}" class="operations-status">{{notice}}</view>
  <view wx:if="{{pendingSocialReady}}" class="social-card"><view class="social-heading">上次提交待确认</view><button class="operations-button" bindtap="retrySocialSubmission" loading="{{busy}}" disabled="{{busy || loading || syncFailed || guest || socialUploading}}">重试上次提交</button><button class="operations-link" bindtap="loadOperations" disabled="{{busy || socialUploading}}">刷新记录</button></view>
  <block wx:if="{{socialStage !== 'history'}}">
    <view wx:if="{{socialDisabledReason}}" class="social-availability">{{socialDisabledReason}}</view>
    <view wx:if="{{socialTab !== 'follow' && socialStage === 'platform'}}" class="social-card">
      <view class="social-heading">选择{{socialActionLabel}}平台</view>
      <view class="social-platforms"><button wx:for="{{platformOptions}}" wx:key="key" class="social-platform {{item.selected ? 'is-selected' : ''}}" data-key="{{item.key}}" bindtap="selectSocialPlatform" disabled="{{busy || socialUploading}}"><view class="social-platform__label">{{item.label}}</view><image wx:if="{{item.selected}}" src="/assets/icons/check.png" mode="aspectFit" class="social-platform__check"/></button></view>
      <button class="operations-button" bindtap="nextSocialStep" disabled="{{busy || socialUploading}}">继续</button>
    </view>
    <block wx:if="{{socialStage === 'requirements'}}">
      <view wx:if="{{socialTab === 'follow'}}" class="social-card"><view class="social-brand-card__head"><view><view class="social-heading">{{brandProfile.name}}</view><view class="operations-meta">小红书号 {{brandProfile.accountId}}</view></view><image class="social-brand-card__preview" src="/assets/brand/xiaohongshu-profile.jpg" mode="aspectFit" bindtap="previewBrandProfile"/></view><button class="operations-button" bindtap="copyBrandLink">复制品牌主页</button><button class="operations-link" bindtap="previewBrandProfile">查看小红书名片</button></view>
      <view class="social-card"><view class="social-heading">{{socialTab === 'follow' ? '关注品牌小红书' : platformLabel + socialActionLabel}}</view>
        <view class="social-requirement">{{socialTab === 'follow' ? '关注品牌账号，截图保留关注状态。' : socialTab === 'interaction' ? '在品牌相关内容完成点赞、评论或收藏，并保留截图。' : socialTab === 'repost' ? '转发品牌相关内容，并保留完成截图。' : '发布本人的真实品牌体验，并保留帖子截图。'}}</view>
        <view wx:if="{{socialRewardLabel}}" class="social-reward">审核通过 {{socialRewardLabel}}</view>
        <view wx:if="{{studentSocialRewardLabel}}" class="social-reward">{{studentSocialRewardLabel}}</view>
        <button class="operations-button" bindtap="nextSocialStep" disabled="{{busy || socialUploading || !socialCanSubmit || pendingSocialReady}}">{{socialCanSubmit ? '提交核验材料' : '暂不能提交'}}</button>
        <button wx:if="{{socialTab !== 'follow'}}" class="operations-link" bindtap="previousSocialStep" disabled="{{busy || socialUploading}}">重选平台</button>
        <button wx:if="{{socialInstructions || socialTaskDescription}}" class="operations-link" bindtap="toggleSocialRules" aria-expanded="{{detailedRulesOpen}}">{{detailedRulesOpen ? '收起活动规则' : '查看活动规则'}}</button><view wx:if="{{detailedRulesOpen}}" class="operations-copy">{{socialInstructions || socialTaskDescription}}</view>
      </view>
    </block>
    <view wx:if="{{socialStage === 'submit'}}" class="social-card"><view class="social-heading">{{platformLabel}}{{socialActionLabel}}核验</view><view wx:if="{{socialRevisionLabel}}" class="operations-status">{{socialRevisionLabel}}</view>
      <view wx:if="{{socialTab === 'interaction'}}" class="social-interactions"><button wx:for="{{interactionOptions}}" wx:key="key" class="{{interactionType === item.key ? 'is-selected' : ''}}" data-key="{{item.key}}" bindtap="selectSocialInteraction" disabled="{{busy || socialUploading || pendingSocialReady}}">{{item.label}}</button></view>
      <view wx:if="{{socialTab !== 'follow' && selectedPlatform !== 'WECHAT_MOMENTS'}}" class="social-field"><view class="operations-label">帖子链接（选填）</view><input class="operations-input" maxlength="1000" value="{{socialPostUrl}}" placeholder="粘贴完整帖子链接" bindinput="changeSocialLink" disabled="{{busy || socialUploading || !socialCanSubmit || pendingSocialReady}}"/></view>
      <view class="social-field"><view class="operations-label">核验截图 · 1—3张</view><view class="social-proof-grid"><view class="social-proof-item" wx:for="{{proofItems}}" wx:key="localId"><image wx:if="{{item.localPath}}" src="{{item.localPath}}" mode="aspectFit" data-index="{{index}}" bindtap="previewSocialProof"/><button wx:else class="social-proof-item__remote" data-index="{{index}}" bindtap="previewSocialProof" disabled="{{!!previewingProofId}}">查看截图</button><button class="social-proof-remove" data-index="{{index}}" bindtap="removeSocialProof" disabled="{{busy || socialUploading || pendingSocialReady}}">移除</button></view><button wx:if="{{proofItems.length < 3}}" class="social-proof-add" bindtap="chooseSocialProof" disabled="{{busy || socialUploading || !socialCanSubmit || pendingSocialReady}}">添加截图</button></view></view>
      <view class="social-field"><view class="operations-label">核验说明</view><textarea class="operations-textarea" value="{{socialNote}}" maxlength="1000" placeholder="填写发布昵称与内容说明" bindinput="changeSocialNote" disabled="{{busy || socialUploading || !socialCanSubmit || pendingSocialReady}}"/></view>
      <checkbox-group bindchange="changeSocialConsent"><label class="operations-confirm"><checkbox value="confirmed" checked="{{socialConfirmed}}" color="#111111" disabled="{{busy || socialUploading || !socialCanSubmit || pendingSocialReady}}"/><text>材料真实，同意用于本次核验。</text></label></checkbox-group>
      <button class="operations-button" bindtap="submitSocial" loading="{{busy || socialUploading}}" disabled="{{busy || loading || syncFailed || socialUploading || !socialCanSubmit || !socialConfirmed || !proofItems.length || pendingSocialReady}}">{{socialUploading ? '正在上传截图' : socialRevisionLabel ? '重新提交审核' : '提交审核'}}</button>
      <view class="social-secondary-actions"><button class="operations-link" bindtap="previousSocialStep" disabled="{{busy || socialUploading}}">返回</button><button class="operations-link" bindtap="clearSocialDraft" disabled="{{busy || socialUploading || pendingSocialReady}}">清空草稿</button></view>
    </view>
  </block>
  <block wx:if="{{socialStage === 'history' && overview}}"><view class="social-history-heading">我的核验记录</view>
    <view wx:if="{{overview.mySocialSubmissionsEmpty}}" class="social-card"><view class="social-heading">暂无记录</view><button class="operations-button" data-tab="share" bindtap="changeSocialTab">参与发帖活动</button></view>
    <view class="social-record" wx:for="{{overview.mySocialSubmissions}}" wx:key="id"><view class="social-record__head"><view class="social-record__title">{{item.title}}</view><text class="social-status">{{item.statusLabel}}</text></view><view class="operations-meta">{{item.dateLabel}}</view><view wx:if="{{item.rewardLabel}}" class="social-record__reward">{{item.rewardLabel}}</view><view wx:if="{{item.reviewNote}}" class="social-review-note">{{item.reviewNote}}</view><button class="operations-link" data-id="{{item.id}}" bindtap="toggleSocialRecord">{{expandedSocialRecordId === item.id ? '收起材料' : '查看材料'}}</button><view wx:if="{{expandedSocialRecordId === item.id}}"><view class="operations-post__text">{{item.note}}</view><view wx:if="{{item.postUrl}}" class="social-record__link">{{item.postUrl}}</view><view class="social-record__proofs"><button wx:for="{{item.proofs}}" wx:for-item="proof" wx:key="id" class="operations-link" data-submission="{{item.id}}" data-id="{{proof.id}}" bindtap="previewSocialProof" disabled="{{!!previewingProofId}}">查看截图</button></view></view><button wx:if="{{item.status === 'REJECTED'}}" class="operations-button operations-button--plain" data-id="{{item.id}}" bindtap="reviseSocialSubmission" disabled="{{busy || loading || syncFailed || socialUploading || pendingSocialReady}}">修改后重提</button></view>
    <view wx:if="{{overview.myPosts.length || overview.myComments.length}}" class="social-legacy"><button class="operations-link" bindtap="toggleLegacyHistory">{{legacyHistoryOpen ? '收起往期记录' : '查看往期记录'}}</button><block wx:if="{{legacyHistoryOpen}}"><view class="social-record" wx:for="{{overview.myPosts}}" wx:key="id"><view class="social-record__title">{{item.statusLabel}}</view><view class="operations-post__text">{{item.text}}</view></view><view class="social-record" wx:for="{{overview.myComments}}" wx:key="id"><view class="social-record__title">{{item.statusLabel}}</view><view class="operations-post__text">{{item.text}}</view></view></block></view>
  </block>
</view>
<privacy-sheet id="privacy-sheet"/>
