@import "../../common/member-operations.wxss";
.social-requirement{font-size:27rpx;line-height:1.9;color:#555}
.social-interactions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx;margin:26rpx 0 34rpx}
.social-interactions button{width:100%;min-width:0;box-sizing:border-box;margin:0!important;padding:24rpx 12rpx;border:1rpx solid #d9d9d9;border-radius:14rpx;background:#fff;color:#444;font-size:27rpx}
.social-interactions button.is-selected{background:#171717;border-color:#171717;color:#fff}
.social-secondary-actions{display:grid;grid-template-columns:1fr 1fr;gap:22rpx;margin-top:18rpx}
.social-intro{margin-bottom:30rpx;max-width:620rpx}
.social-card{padding:32rpx;background:#fff;border:1rpx solid #e7e7e7;border-radius:22rpx;margin-top:22rpx}
.social-heading{font-size:30rpx;font-weight:600;line-height:1.6;margin-bottom:20rpx}
.social-platforms{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx;margin:18rpx 0 28rpx}
.social-platform{display:flex;align-items:center;justify-content:center;min-height:100rpx;padding:22rpx;margin:0!important;border:1rpx solid #dedede;border-radius:14rpx;background:#fff;color:#555;font-size:27rpx;font-weight:400;line-height:1.6}
.social-platform.is-selected{background:#1c1c1c;border-color:#1c1c1c;color:#fff}
.social-field{margin-top:28rpx}
.social-proof{padding:26rpx;border:1rpx dashed #cfcfcf;border-radius:16rpx;background:#fafafa;margin-top:20rpx}
.social-proof__title{font-size:26rpx;font-weight:500;color:#333;line-height:1.7}
.social-proof__copy{font-size:24rpx;color:#777;line-height:1.85;margin-top:10rpx}
.social-rules{padding:26rpx;background:#eeeeee;border-radius:16rpx;margin-top:28rpx}
.social-rules__title{font-size:26rpx;font-weight:500;line-height:1.7;margin-bottom:10rpx}
.social-rules__item{font-size:24rpx;line-height:1.85;color:#707070;margin-top:10rpx}
.social-status{display:inline-flex;align-items:center;min-height:48rpx;padding:7rpx 16rpx;background:#eee;color:#555;border-radius:8rpx;font-size:23rpx;line-height:1.5}
.social-media-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx;margin-top:22rpx}
.social-media-item{position:relative;min-width:0;aspect-ratio:1;border-radius:14rpx;overflow:hidden;background:#eee}
.social-media-item image{display:block;width:100%;height:190rpx}
.social-media-remove{position:absolute;right:6rpx;top:6rpx;width:64rpx!important;min-height:64rpx;padding:0!important;margin:0!important;background:#222;color:#fff;border-radius:50%;font-size:28rpx;line-height:64rpx;text-align:center}
.social-media-add{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:190rpx;padding:18rpx;margin:0!important;border:1rpx dashed #bbb;border-radius:14rpx;background:#f8f8f8;color:#555;font-size:24rpx;line-height:1.7}
.social-record{padding:30rpx;background:#fff;border:1rpx solid #e7e7e7;border-radius:22rpx;margin-top:20rpx}
.social-record__head{display:flex;align-items:center;justify-content:space-between;gap:18rpx}
.social-record__title{font-size:28rpx;font-weight:500;line-height:1.6}
.social-record__link{font-size:24rpx;line-height:1.8;color:#737373;margin-top:14rpx;overflow-wrap:anywhere}
.social-tabs{display:flex;gap:14rpx;padding:6rpx;margin-top:28rpx;background:#eaeaea;border-radius:16rpx}
.social-tabs button{display:flex;align-items:center;justify-content:center;flex:1;min-height:86rpx;padding:20rpx 12rpx;margin:0!important;border-radius:12rpx;background:transparent;color:#777;font-size:26rpx;line-height:1.6}
.social-tabs button.is-selected{background:#fff;color:#161616}
.social-step-label{margin:36rpx 2rpx 18rpx;font-size:24rpx;line-height:1.8;color:#777}
.social-availability{padding:24rpx 28rpx;background:#ebebeb;border:1rpx solid #e1e1e1;border-radius:16rpx;font-size:25rpx;line-height:1.85;color:#666;margin-top:22rpx}
.social-platform{width:100%!important;justify-content:space-between;gap:12rpx;min-height:142rpx;text-align:left;padding:26rpx 22rpx}
.social-platform>view{flex:1;min-width:0}
.social-platform__label{font-size:28rpx;line-height:1.6;font-weight:500}
.social-platform__hint{font-size:22rpx;line-height:1.8;color:#858585;margin-top:8rpx}
.social-platform.is-selected .social-platform__hint{color:#d1d1d1}
.social-platform__check{width:30rpx;height:30rpx;flex:none;padding:5rpx;border-radius:50%;background:#fff}
.social-brand-card__head{display:flex;align-items:center;justify-content:space-between;gap:24rpx;margin-bottom:24rpx}
.social-brand-card__head>view{flex:1;min-width:0}
.social-brand-card__head .social-heading{font-size:30rpx;overflow-wrap:anywhere;margin-bottom:12rpx}
.social-brand-card__head .operations-meta{font-size:22rpx;margin-top:0}
.social-brand-card__preview{flex:none;width:126rpx;height:176rpx;border-radius:10rpx;background:#f5f5f5}
.social-rule-row{display:flex;align-items:flex-start;gap:18rpx;margin-top:26rpx;font-size:26rpx;line-height:1.85;color:#5d5d5d}
.social-rule-row__number{display:flex;align-items:center;justify-content:center;flex:none;width:42rpx;height:42rpx;margin-top:3rpx;background:#ededed;color:#555;border-radius:50%;font-size:23rpx;line-height:1}
.social-reward{padding:24rpx;background:#f2f2f2;border-radius:14rpx;margin-top:28rpx;color:#333;font-size:27rpx;font-weight:500;line-height:1.75}
.social-reward text{display:block;font-size:23rpx;font-weight:400;color:#777;margin-top:10rpx}
.social-field:first-of-type{margin-top:20rpx}
.social-field .operations-label{display:flex;justify-content:space-between;align-items:center;gap:14rpx;margin-top:0}
.social-field__hint{font-size:22rpx;font-weight:400;color:#858585}
.social-proof-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16rpx}
.social-proof-item{min-width:0;background:#f4f4f4;border:1rpx solid #e3e3e3;border-radius:14rpx;overflow:hidden}
.social-proof-item>image{display:block;width:100%;height:178rpx}
.social-proof-item__remote{display:flex;align-items:center;justify-content:center;width:100%!important;min-height:178rpx;padding:22rpx 16rpx;margin:0!important;background:#eee;font-size:23rpx;line-height:1.7;color:#666;text-align:center;border-radius:0}
.social-proof-remove{display:flex;align-items:center;justify-content:center;width:100%!important;min-height:78rpx;padding:18rpx 8rpx;margin:0!important;background:#fff;color:#666;font-size:23rpx;line-height:1.7;border-radius:0}
.social-proof-add{display:flex;align-items:center;justify-content:center;width:100%!important;min-height:178rpx;padding:22rpx 12rpx;margin:0!important;background:#f8f8f8;border:1rpx dashed #bbb;border-radius:14rpx;color:#666;font-size:25rpx;line-height:1.7}
.social-character-count{text-align:right;font-size:22rpx;line-height:1.8;color:#8a8a8a;margin-top:10rpx}
.social-clear-button{display:flex;align-items:center;justify-content:center;min-height:88rpx;width:100%!important;padding:20rpx;margin:12rpx 0 0!important;border-radius:14rpx;background:transparent;color:#777;font-size:25rpx;line-height:1.7}
.social-history-heading{margin:42rpx 0 24rpx;font-size:31rpx;line-height:1.6;font-weight:600}
.social-empty{padding-top:46rpx;padding-bottom:38rpx}
.social-review-note{padding:22rpx;margin-top:22rpx;border-radius:14rpx;background:#f1f1f1;font-size:25rpx;line-height:1.85;color:#606060;white-space:pre-wrap}
.social-record__reward{font-size:27rpx;font-weight:500;color:#333;line-height:1.7;margin-top:16rpx}
.social-record__proofs{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:18rpx}
.social-record__proofs .operations-link{min-width:150rpx;margin-top:0!important;flex:1}
.social-legacy{margin-top:44rpx}
@media(max-width:340px){.social-card,.social-record{padding:26rpx}.social-platform{padding:22rpx 18rpx;min-height:138rpx}.social-platform__hint{font-size:22rpx}.social-brand-card__preview{width:112rpx;height:158rpx}.social-brand-card__head{gap:18rpx}.social-proof-grid{gap:12rpx}.social-proof-add{font-size:23rpx}}
