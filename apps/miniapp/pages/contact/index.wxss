page{background:#fff}.help-page{padding:42rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));color:#111}.help-kicker{font-size:20rpx;letter-spacing:3rpx;color:#777}.help-title{font-size:52rpx;line-height:1.3;font-weight:600;margin-top:18rpx}.help-intro{font-size:28rpx;color:#777;line-height:1.7;margin-top:16rpx}.help-heading{padding-bottom:38rpx}.help-service{padding:34rpx 30rpx;background:#f6f6f4;border-radius:24rpx}.help-service__title{font-size:35rpx;font-weight:500;line-height:1.5}.help-service__copy{font-size:26rpx;color:#666;line-height:1.8;margin:12rpx 0 28rpx}.help-hours{font-size:23rpx;color:#777;text-align:center;margin-top:20rpx;line-height:1.7}.help-notice{margin-top:20rpx;font-size:25rpx;color:#866043;line-height:1.7}.help-group{margin-top:44rpx}.help-group__title{font-size:31rpx;font-weight:600;margin-bottom:10rpx}.help-row{box-sizing:border-box;width:100%!important;margin:0!important;display:flex;align-items:center;justify-content:space-between;gap:24rpx;min-height:126rpx;padding:28rpx 0;text-align:left;border-radius:0;border-bottom:1rpx solid #e9e9e9;background:none;font-size:29rpx;font-weight:400;line-height:1.5}.help-row>view{min-width:0}.help-row>view>view{font-size:24rpx;color:#777;margin-top:8rpx;line-height:1.6}.help-row image{width:25rpx;height:25rpx;flex-shrink:0;opacity:.6}.help-more{box-sizing:border-box;width:100%!important;margin:0!important;padding:28rpx 0;display:flex;justify-content:space-between;background:none;border-radius:0;font-size:28rpx;font-weight:400}.help-email{display:flex;justify-content:space-between;gap:16rpx;align-items:center;padding:24rpx 0;font-size:24rpx;color:#666;border-top:1rpx solid #eee}.help-email>view{min-width:0;word-break:break-all;line-height:1.7}.help-email>view>text{font-size:25rpx;color:#111}.help-email button{width:auto!important;flex-shrink:0;margin:0;padding:12rpx 20rpx;font-size:24rpx;background:#f5f5f5;border-radius:999rpx}.help-footer{display:flex;flex-direction:column;align-items:center;gap:14rpx;margin-top:50rpx;color:#999;font-size:21rpx}.help-footer button{width:auto!important;margin:0;padding:0;background:none;border-radius:0;color:#666;font-size:24rpx;line-height:1.8}.help-page button:after{border:0}

.help-haptic{margin-top:44rpx;padding:30rpx;border:1rpx solid #e9e9e9;border-radius:24rpx;scroll-margin-top:200rpx}.help-haptic__actions{display:flex;gap:18rpx;margin-top:24rpx}.help-haptic__actions button{width:auto!important;flex:1;margin:0;padding:24rpx 12rpx;border-radius:14rpx;background:#111;color:#fff;font-size:27rpx;line-height:1.5;font-weight:500}.help-haptic__actions button[disabled]{background:#d6d6d6;color:#fff}.help-haptic__status{font-size:26rpx;line-height:1.6;margin-top:22rpx;color:#333}.help-haptic__copy{width:auto!important;margin:24rpx 0 0;padding:16rpx 24rpx;border-radius:12rpx;background:#f4f4f4;color:#111;font-size:25rpx;line-height:1.5}
