<brand-header back show-search="{{false}}" show-bag="{{false}}"/>
<view class="help-page">
 <view class="help-heading"><view class="help-kicker">HERE TO HELP</view><view class="help-title">帮助与客服</view><view class="help-intro">从选对尺码，到收到商品。</view></view>
 <view class="help-service"><view class="help-service__title">有什么可以帮你？</view><view class="help-service__copy">商品、尺码或订单问题，都可以联系我们。</view><service-contact id="help-contact" bind:unavailable="serviceError"/><view class="help-hours">服务时间 · 工作日 10:00–18:00</view><view wx:if="{{serviceUnavailable}}" class="help-notice">微信客服暂时无法打开，已展开邮箱联系方式。</view></view>
 <view class="help-group"><view class="help-group__title">订单服务</view><button id="help-orders" class="help-row vk-button-content" bindtap="openOrders"><view><text>我的订单</text><view>付款状态与配送进度</view></view><image src="/assets/icons/chevron-right.png"/></button><button id="help-after-sales" class="help-row vk-button-content" bindtap="openAfterSales"><view><text>售后服务</text><view>申请退换、补充资料与查看进度</view></view><image src="/assets/icons/chevron-right.png"/></button></view>
 <view class="help-group"><view class="help-group__title">常见问题</view><button wx:for="{{topics}}" wx:key="key" id="help-{{item.key}}" class="help-row vk-button-content" data-key="{{item.key}}" bindtap="openTopic"><view><text>{{item.title}}</text><view>{{item.copy}}</view></view><image src="/assets/icons/chevron-right.png"/></button></view>
 <view class="help-group help-group--last"><button class="help-more vk-button-content" id="help-more" bindtap="toggleMore" aria-expanded="{{moreOpen}}"><text>其他联系方式</text><text>{{moreOpen?'−':'+'}}</text></button><view wx:if="{{moreOpen}}"><view class="help-email" wx:for="{{emails}}" wx:key="address"><view><text>{{item.label}}</text><view>{{item.address}}</view></view><button class="vk-button-content" data-email="{{item.address}}" bindtap="copyEmail">复制</button></view></view></view>
 <view wx:if="{{hapticTestOpen}}" id="haptic-test" class="help-haptic"><view class="help-group__title">震动测试</view><view class="help-haptic__actions"><button id="haptic-short" class="vk-button-content" data-kind="short" bindtap="runHapticTest" disabled="{{hapticBusy}}">测试短震动</button><button id="haptic-long" class="vk-button-content" data-kind="long" bindtap="runHapticTest" disabled="{{hapticBusy}}">测试长震动</button></view><view wx:if="{{hapticStatus}}" class="help-haptic__status">{{hapticStatus}}</view><button id="haptic-copy" class="help-haptic__copy vk-button-content" bindtap="copyHapticDiagnostic">复制检测信息</button></view>
 <view class="help-footer"><button class="vk-button-content" bindtap="openHapticTest">测试震动</button><button class="vk-button-content" bindtap="openPrivacy">隐私与个人信息权利</button><text>MerchantKit · 界面版本 {{version}}</text></view>
</view>
<privacy-sheet id="privacy-sheet"/>
