:host{position:static}.privacy-sheet-layer{position:fixed;z-index:9999;inset:0;color:#111}.privacy-sheet-mask{position:absolute;inset:0;background:rgba(0,0,0,.38)}.privacy-sheet{position:absolute;bottom:0;left:0;right:0;box-sizing:border-box;max-height:55vh;display:flex;flex-direction:column;background:#fff;border-radius:28rpx 28rpx 0 0;padding:38rpx 34rpx calc(26rpx + env(safe-area-inset-bottom))}.privacy-sheet-title{font-size:36rpx;line-height:1.5;font-weight:600}.privacy-sheet-copy{font-size:27rpx;line-height:1.9;color:#555;margin-top:20rpx}.privacy-sheet-link{color:#111;font-weight:500;text-decoration:underline}.privacy-sheet-links{display:flex;flex-wrap:wrap;margin:16rpx -8rpx 20rpx;gap:4rpx 0}.privacy-sheet-links button{font-size:26rpx;line-height:1.8;color:#111;padding:8rpx;margin:0;border:0;background:transparent;border-radius:0}.privacy-sheet-links button::after{border:0}.privacy-sheet-actions{margin-top:28rpx}.privacy-sheet-actions button{display:flex;align-items:center;justify-content:center;width:100%;box-sizing:border-box;min-height:88rpx;padding:18rpx 24rpx;font-size:28rpx;line-height:1.6;font-weight:500;border-radius:12rpx;margin:0}.privacy-sheet-primary{background:#111;color:#fff}.privacy-sheet-secondary{background:#fff;color:#444;border:1rpx solid #d4d4d4;margin-top:14rpx!important}.privacy-sheet-actions button::after{border:0}.privacy-sheet-error{font-size:25rpx;line-height:1.7;color:#444;padding:0 0 16rpx}.privacy-sheet-actions button[disabled]{opacity:.6}@media(max-height:650px){.privacy-sheet{max-height:55vh;padding-top:26rpx}.privacy-sheet-copy{font-size:24rpx;margin-top:12rpx;line-height:1.75}.privacy-sheet-links{margin-top:8rpx;margin-bottom:12rpx}.privacy-sheet-actions button{min-height:76rpx;padding:14rpx 20rpx}}
