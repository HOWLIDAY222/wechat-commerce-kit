.product-card {
  min-width: 0;
  background: var(--tc-paper);
  transition: opacity 160ms ease, transform 160ms ease;
}

.product-card--pressed {
  opacity: 0.76;
  transform: scale(0.988);
}

.product-card__media {
  position: relative;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  background: var(--tc-soft);
}

.product-card__image {
  width: 100%;
  height: 100%;
}

.product-card__body {
  min-height: 172rpx;
  padding: 20rpx 12rpx 34rpx;
}

.product-card__meta {
  overflow: hidden;
  color: var(--tc-muted);
  font-size: 18rpx;
  letter-spacing: 0.02em;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-card__name {
  min-height: 68rpx;
  margin-top: 10rpx;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.28;
}

.product-card__price,
.product-card__release {
  margin-top: 14rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.product-card__release {
  color: var(--tc-muted);
}
