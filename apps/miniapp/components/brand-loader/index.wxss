:host{display:block}.brand-loader{display:flex;min-height:440rpx;box-sizing:border-box;padding:40rpx 24rpx;flex-direction:column;align-items:center;justify-content:center;gap:24rpx;background:#f5f5f4;color:#737373}.brand-loader--compact{min-height:200rpx;padding:24rpx}.brand-loader--overlay{position:absolute;top:0;right:0;bottom:0;left:0;z-index:4;min-height:0;background:rgba(245,245,244,.96);pointer-events:none}.brand-loader__tile{display:flex;width:192rpx;height:192rpx;flex-shrink:0;align-items:center;justify-content:center;border-radius:26rpx;background:#151515;animation:brand-loader-breathe 1.6s ease-in-out infinite}.brand-loader__wordmark{display:block;width:164rpx;height:34rpx;filter:brightness(0) invert(1)}.brand-loader__label{font-size:23rpx;line-height:1.6;text-align:center}.brand-loader--compact .brand-loader__tile{width:156rpx;height:156rpx;border-radius:22rpx}.brand-loader--compact .brand-loader__wordmark{width:132rpx;height:28rpx}@keyframes brand-loader-breathe{0%,100%{opacity:.68;transform:scale(.98)}50%{opacity:1;transform:scale(1)}}@media(prefers-reduced-motion:reduce){.brand-loader__tile{animation:none}}
