<button wx:if="{{supported && privacyAccepted}}" id="native-contact" class="service-button service-button--{{mode}}" open-type="contact" session-from="{{context.sessionFrom}}" show-message-card="{{context.showMessageCard}}" send-message-title="{{context.messageTitle}}" send-message-path="{{context.messagePath}}" send-message-img="{{context.messageImage}}" binderror="contactError" hover-class="service-button--pressed" aria-label="{{mode==='toolbar'?'微信客服':'微信联系客服'}}" bindtap="feedbackTap"><view wx:if="{{mode==='toolbar'}}" class="service-symbol" aria-hidden="true"/><text>{{mode==='toolbar'?'客服':mode==='order'?'咨询此订单':'微信联系客服'}}</text><text wx:if="{{mode==='order'}}" class="service-arrow">↗</text></button>
<button wx:elif="{{!privacyAccepted}}" class="service-button service-button--{{mode}}" bindtap="acceptPrivacy" hover-class="service-button--pressed"><view wx:if="{{mode==='toolbar'}}" class="service-symbol" aria-hidden="true"/><text>{{mode==='toolbar'?'客服':mode==='order'?'咨询此订单':'微信联系客服'}}</text></button>
<button wx:else class="service-button service-button--{{mode}}" bindtap="openHelp">联系与帮助</button>
<view wx:if="{{unavailable && mode==='primary'}}" class="service-error">暂时无法打开客服，请使用下方邮箱联系。</view>
