:host{display:block}button{box-sizing:border-box;margin:0!important;width:100%!important;border:0;font-family:inherit}button:after{border:0}.service-button{display:flex;align-items:center;justify-content:center;gap:14rpx;background:#111;color:#fff;font-size:29rpx;line-height:1.5;min-height:96rpx;padding:24rpx 30rpx;border-radius:999rpx;font-weight:500}.service-button--pressed{opacity:.8}.service-button--toolbar{flex-direction:column;gap:10rpx;min-height:94rpx;padding:0;color:#111;background:none;border-radius:0;font-size:23rpx;font-weight:400}.service-symbol{box-sizing:border-box;position:relative;width:34rpx;height:30rpx;border:3rpx solid currentColor;border-bottom:0;border-radius:20rpx 20rpx 0 0;margin-top:4rpx}.service-symbol:before,.service-symbol:after{content:"";position:absolute;bottom:-3rpx;width:7rpx;height:16rpx;background:currentColor;border-radius:3rpx}.service-symbol:before{left:-5rpx}.service-symbol:after{right:-5rpx}.service-button--order{justify-content:space-between;border:1rpx solid #dedede;background:#fff;color:#111;border-radius:0;min-height:102rpx;padding:28rpx 0}.service-arrow{font-size:28rpx;color:#777}.service-error{font-size:25rpx;color:#866043;line-height:1.7;margin-top:20rpx}
