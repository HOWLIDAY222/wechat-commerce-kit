.brand-header{background:#fff;position:sticky;top:0;z-index:40}
.brand-header__bar{position:relative;display:flex;align-items:center;padding-left:36rpx;box-sizing:border-box}
.brand-header button{display:flex;align-items:center;justify-content:center;padding:0!important;margin:0!important;background:transparent;border:0;border-radius:0;line-height:1;color:#111;box-sizing:border-box}
.brand-header button::after{border:0}
.brand-header__brand{width:300rpx;max-width:100%;height:44px;min-width:0;flex:0 1 300rpx}
.brand-header__brand--compact{width:280rpx;flex-basis:280rpx}
.brand-header__logo{display:block;width:100%;height:56rpx}
.brand-header__fallback{display:block;max-width:100%;white-space:nowrap;font-size:28rpx;font-weight:400;line-height:1.2;letter-spacing:-.6rpx}
.brand-header .brand-header__icon-button{width:60rpx!important;min-width:60rpx;max-width:60rpx;height:44px;flex:0 0 60rpx;margin:0 18rpx 0 -12rpx!important}
.brand-header__icon{width:32rpx;height:32rpx}
.brand-header__bar--home{padding-left:0}
.brand-header--home{background:#fff;border-bottom:1px solid #e3e3e3}
.brand-header__actions{position:absolute;left:12px;top:50%;transform:translateY(-50%);display:flex;align-items:center;gap:7px;height:36px;width:88px;box-sizing:border-box}
.brand-header .brand-header__search-button{width:30px!important;min-width:30px;flex:0 0 30px;height:34px;border-radius:6px;background:rgba(17,17,17,.055)}
.brand-header__search-icon{display:block;width:17px;height:17px}
.brand-header .brand-header__subscribe-button{width:51px!important;min-width:0;flex:1;height:34px;gap:4px;font-size:12px;font-weight:500;color:#111111;white-space:nowrap;border-bottom:1px solid #777777}
.brand-header__bell-icon{display:block;width:14px;height:14px;flex:none}
.brand-header .brand-header__brand--centered{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);max-width:calc(100% - 208px);flex:none}
.brand-header__brand--centered .brand-header__logo{height:25px}
.brand-header__brand--centered .brand-header__fallback{font-size:14px;letter-spacing:-.5px}
.brand-header .brand-header__button--pressed{opacity:.6}
