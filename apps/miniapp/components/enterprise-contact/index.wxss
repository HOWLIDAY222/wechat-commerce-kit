.enterprise-contact{padding:26rpx 0;color:#111;border-bottom:1rpx solid #e3e3e3}
.enterprise-contact__row{display:flex;align-items:center;justify-content:space-between;gap:24rpx;min-height:88rpx}
.enterprise-contact__copy{flex:1;min-width:0}
.enterprise-contact__title{font-size:27rpx;font-weight:500;line-height:1.6;overflow-wrap:anywhere}
.enterprise-contact__description{margin-top:8rpx;color:#707070;font-size:23rpx;font-weight:400;line-height:1.8}
.enterprise-contact__action{flex:none;min-width:88rpx;min-height:88rpx;display:flex;align-items:center;justify-content:center}
.enterprise-contact__status{margin-top:18rpx;padding:18rpx 20rpx;border-radius:8rpx;background:#f5f5f5;color:#666;font-size:23rpx;line-height:1.8}
.enterprise-contact__status--error{border-left:3rpx solid #777}
