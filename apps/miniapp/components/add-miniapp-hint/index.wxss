.add-miniapp-hint{position:relative;z-index:1;display:flex;align-items:center;gap:16rpx;box-sizing:border-box;width:100%;padding:16rpx 28rpx 16rpx 36rpx;background:#111;color:#fff}
.add-miniapp-hint__pointer{position:absolute;top:-12rpx;width:0;height:0;transform:translateX(-50%);border-left:16rpx solid transparent;border-right:16rpx solid transparent;border-bottom:12rpx solid #111}
.add-miniapp-hint__copy{flex:1;min-width:0}.add-miniapp-hint__title{display:flex;align-items:center;gap:10rpx;font-size:25rpx;line-height:1.6;font-weight:400}.add-miniapp-hint__dots{letter-spacing:4rpx;font-size:26rpx;white-space:nowrap}.add-miniapp-hint__note{display:block;margin-top:2rpx;color:#c9c9c9;font-size:21rpx;line-height:1.6}
.add-miniapp-hint__close{box-sizing:border-box;display:flex;align-items:center;justify-content:center;flex:0 0 84rpx;width:84rpx!important;height:84rpx;margin:-8rpx -12rpx -8rpx 0!important;padding:0;border:0;border-radius:0;background:none;color:#fff;font-size:42rpx;line-height:1;font-weight:300}.add-miniapp-hint__close::after{border:0}
