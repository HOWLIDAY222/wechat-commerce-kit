.brand-loading{padding:32rpx 0;color:#707070}.brand-loading--home,.brand-loading--detail{padding:12rpx 36rpx 36rpx}.skeleton{background:#f0f0f0;border-radius:12rpx;animation:skeleton-breathe 1.4s ease-in-out infinite}.skeleton--hero{height:540rpx;margin-bottom:32rpx;border-radius:22rpx}.brand-loading--detail .skeleton--hero{height:660rpx}.skeleton-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.skeleton--card{height:330rpx;margin-bottom:24rpx}.skeleton-row{display:flex;gap:24rpx;padding:22rpx 0}.skeleton-copy{flex:1;padding-top:8rpx}.skeleton--line{height:24rpx;width:85%;margin-bottom:20rpx}.skeleton--short{width:54%;height:20rpx}.skeleton--thumb{width:230rpx;height:280rpx;flex-shrink:0}.brand-loading__label{display:block;margin-top:20rpx;font-size:24rpx;text-align:center;line-height:1.6}@keyframes skeleton-breathe{0%,100%{opacity:.55}50%{opacity:1}}@media(prefers-reduced-motion:reduce){.skeleton{animation:none}}
