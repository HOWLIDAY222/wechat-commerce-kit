:host{display:block}.share-trigger{display:flex;align-items:center;gap:8rpx;width:auto;margin:0;padding:12rpx 0 12rpx 16rpx;min-height:72rpx;border:0;border-radius:0;background:none;color:#666;font-size:24rpx;line-height:1.4;white-space:nowrap}.share-trigger::after,button::after{border:0}.share-icon{font-size:36rpx;line-height:1}.share-cover-canvas{position:fixed;top:-1000px;left:-1000px;width:500px;height:500px;pointer-events:none}.share-overlay,.share-guide-overlay{position:fixed;inset:0;z-index:190;background:rgba(0,0,0,.45)}.share-sheet{position:absolute;bottom:0;left:0;right:0;padding:28rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));background:#fff;border-radius:24rpx 24rpx 0 0}.share-heading{display:flex;align-items:center;justify-content:space-between;font-size:30rpx;font-weight:600}.share-heading button{width:72rpx;height:72rpx;margin:0;padding:0;background:none;line-height:72rpx;font-size:40rpx;color:#777}.share-actions{display:grid;grid-template-columns:1fr 1fr;gap:24rpx;padding:30rpx 0 36rpx}.share-actions button{width:100%;margin:0;padding:24rpx 12rpx;border-radius:12rpx;background:#f5f5f4;font-size:26rpx;line-height:1.6;color:#111}.share-option-icon{font-size:48rpx;line-height:1.4;margin-bottom:10rpx}.share-cancel{width:100%;margin:0;padding:20rpx;background:#fff;border-top:1rpx solid #eee;border-radius:0;font-size:27rpx;color:#777}.share-guide{position:absolute;top:180rpx;right:32rpx;max-width:580rpx;padding:28rpx 36rpx;background:#fff;border-radius:16rpx;color:#555;font-size:27rpx;line-height:1.9}.share-guide-arrow{text-align:right;font-size:68rpx;color:#111;line-height:1;margin-bottom:12rpx}.share-guide-title{font-size:32rpx;font-weight:600;color:#111;margin-bottom:12rpx}.share-guide button{margin:24rpx 0 0;padding:18rpx 24rpx;min-height:80rpx;background:#111;color:#fff;font-size:27rpx;border-radius:10rpx}.timeline-preview-note{padding:18rpx 28rpx;background:#f5f5f4;color:#666;font-size:24rpx;line-height:1.7}
