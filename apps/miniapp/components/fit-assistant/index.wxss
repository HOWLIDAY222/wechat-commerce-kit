:host{display:block}.fit-assistant{color:#111;padding:4rpx 0 24rpx}.fit-title{font-size:34rpx;font-weight:600}.fit-copy{font-size:24rpx;line-height:1.8;color:#686866;margin:16rpx 0 24rpx}.fit-fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx;margin:28rpx 0}.fit-fields label{min-width:0;font-size:25rpx}.fit-fields input{box-sizing:border-box;border:1rpx solid #d6d6d4;background:#fff;height:92rpx;padding:0 16rpx;margin-top:14rpx;width:100%;font-size:32rpx}.fit-label{font-size:25rpx;margin-bottom:16rpx}.fit-preferences{display:flex;gap:18rpx}.fit-preferences button{flex:1;border:1rpx solid #d6d6d4;background:#fff;border-radius:8rpx;font-size:27rpx;padding:6rpx}.fit-preferences button.is-active{border-color:#111;background:#efeeec}.fit-result{border-left:4rpx solid #111;background:#f4f3f1;padding:24rpx;font-size:28rpx;line-height:1.7;margin:26rpx 0}.fit-table{width:100%;font-size:26rpx}.fit-row{display:grid;grid-template-columns:0.7fr 1.1fr 1fr;border-bottom:1rpx solid #e8e7e5;padding:22rpx 16rpx}.fit-row--head{color:#6b6b69}.fit-row--selected{background:#111;color:#fff}.fit-row--reference{background:#efeeec}.fit-primary{border-radius:8rpx;background:#111;color:#fff;font-size:27rpx;font-weight:600;min-height:88rpx;line-height:1.5;padding:24rpx 18rpx}.fit-primary[disabled]{background:#aaa;color:#fff}.fit-disclosure,.fit-reload,.fit-login{border-radius:0;background:transparent;text-align:left;font-size:24rpx;padding:18rpx 0;line-height:1.8}.fit-disclosure{border-top:1rpx solid #deddd9;margin-top:24rpx}.fit-consent{display:flex;align-items:flex-start;gap:8rpx;font-size:23rpx;line-height:1.8;margin:16rpx 0 24rpx}.fit-consent checkbox{transform:scale(.78);transform-origin:top left;flex-shrink:0}.fit-actions{display:flex;align-items:center;gap:18rpx}.fit-actions .fit-primary{flex:1}.fit-delete{font-size:24rpx;background:transparent}.fit-message{font-size:26rpx;line-height:1.8;margin:22rpx 0}.fit-reload{color:#6b6b69;text-decoration:underline}button::after{border:0}
