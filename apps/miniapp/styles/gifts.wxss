.gift-page{padding:32rpx 32rpx 80rpx;background:#fff;min-height:100vh;box-sizing:border-box}.gift-heading{margin:12rpx 0 36rpx}.gift-kicker{font-size:20rpx;color:#888;letter-spacing:3rpx;margin-bottom:16rpx}.gift-title{font-size:48rpx;line-height:1.2;font-weight:650}.gift-copy{font-size:25rpx;line-height:1.8;color:#777;margin-top:18rpx}.gift-tabs{display:flex;border-bottom:1rpx solid #e6e6e6;margin-bottom:30rpx}.gift-tabs button{flex:1;font-size:27rpx;padding:22rpx 0;color:#888;background:transparent;border-radius:0}.gift-tabs .active{color:#111;border-bottom:4rpx solid #111;font-weight:600}.gift-tabs button::after,.gift-link::after{border:0}.gift-card{border:1rpx solid #e5e5e5;border-radius:20rpx;padding:28rpx;margin-bottom:26rpx}.gift-card__brand{font-size:19rpx;letter-spacing:3rpx;color:#999}.gift-card__body{display:flex;gap:24rpx;margin-top:24rpx;align-items:center}.gift-card__image{width:150rpx;height:170rpx;border-radius:10rpx;background:#f4f4f2;flex-shrink:0}.gift-card__name{font-size:31rpx;font-weight:600;line-height:1.5}.gift-card__meta{font-size:24rpx;line-height:1.8;color:#777}.gift-card__status{font-size:24rpx;margin-top:20rpx;color:#555}.gift-actions{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:24rpx}.gift-primary,.gift-secondary{font-size:27rpx;border-radius:60rpx;padding:22rpx 30rpx;line-height:1.4;margin:0;box-sizing:border-box}.gift-primary{background:#111;color:#fff}.gift-secondary{background:#fff;color:#111;border:1rpx solid #bbb}.gift-primary[disabled],.gift-secondary[disabled]{opacity:.4}.gift-primary::after,.gift-secondary::after{border:0}.gift-link{font-size:24rpx;background:transparent;padding:14rpx 0;margin:0;text-align:left;color:#777;line-height:1.6}.gift-empty{padding:64rpx 12rpx;text-align:center;font-size:28rpx;line-height:1.7}.gift-empty text{display:block;font-size:24rpx;color:#888;margin:16rpx 0 28rpx}.gift-error{padding:22rpx;background:#faf4ef;font-size:25rpx;line-height:1.8;margin:20rpx 0;border-radius:12rpx}.gift-notice{font-size:25rpx;line-height:1.8;padding:22rpx;background:#f4f4f2;margin-bottom:24rpx;border-radius:12rpx}.gift-section{padding:32rpx 0;border-bottom:1rpx solid #e8e8e8}.gift-section__title{font-size:29rpx;font-weight:600;margin-bottom:20rpx}.gift-section__copy{font-size:25rpx;line-height:1.8;color:#777}.gift-sizes{display:flex;gap:18rpx}.gift-size{flex:1;background:#f5f5f4;color:#111;font-size:28rpx;border-radius:12rpx;padding:22rpx 0;margin:0}.gift-size.active{background:#111;color:#fff}.gift-size[disabled]{color:#aaa;background:#f8f8f8}.gift-size::after{border:0}.gift-amount{display:flex;justify-content:space-between;font-size:27rpx;line-height:2}.gift-address{font-size:27rpx;line-height:1.8}.gift-quote{font-size:28rpx;margin-top:28rpx;line-height:1.8;color:#555}.gift-message{width:100%;min-height:110rpx;box-sizing:border-box;font-size:25rpx;background:#f6f6f4;padding:20rpx;border-radius:12rpx}.gift-confirm{margin-top:32rpx;width:100%;font-size:29rpx}.gift-note{font-size:23rpx;color:#888;line-height:1.8;margin-top:20rpx}.gift-welcome{padding:48rpx 0 28rpx}.gift-hero{width:100%;height:560rpx;background:#f3f3f1;border-radius:20rpx}.gift-price{font-size:36rpx;font-weight:600;margin-top:16rpx}.gift-rules{font-size:24rpx;line-height:1.9;color:#777;padding:20rpx 0}
