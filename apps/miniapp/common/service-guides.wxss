page{background:#fff}.guide-page{padding:0 32rpx calc(44rpx + env(safe-area-inset-bottom))}.guide-heading{padding:36rpx 0 32rpx}.guide-title{font-size:52rpx;line-height:1.4;font-weight:600}.guide-product{font-size:27rpx;color:#666;line-height:1.7;margin-top:12rpx}.guide-tabs{display:flex;gap:8rpx;background:#f1f1f1;border-radius:999rpx;padding:8rpx;margin-bottom:30rpx}.guide-tabs button{flex:1;min-width:0;width:auto!important;min-height:44px;padding:16rpx 8rpx;margin:0!important;background:transparent;border-radius:999rpx;color:#666;font-size:28rpx;line-height:1.5;font-weight:500}.guide-tabs button.is-active{background:#191919;color:#fff}.guide-state{display:flex;flex-direction:column;align-items:center;gap:28rpx;padding:80rpx 36rpx;text-align:center;font-size:28rpx;line-height:1.8;color:#666}.guide-state__title{font-size:46rpx;color:#111;font-weight:600}.guide-state .primary-button{min-height:48px}.guide-text-button{min-height:44px;margin:0!important;padding:18rpx 20rpx;background:transparent;color:#555;font-size:27rpx}.guide-footer{display:flex;gap:18rpx;margin-top:30rpx}.guide-footer button{flex:1;min-width:0;width:auto!important;min-height:48px;margin:0!important;padding:18rpx 8rpx;border:1rpx solid #dedede;border-radius:999rpx;background:#fff;color:#333;font-size:26rpx;line-height:1.6}.guide-footer button:first-child{background:#f1f1f1;border-color:#f1f1f1}
