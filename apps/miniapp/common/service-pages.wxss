/* Shared service-page treatment: same scale and surfaces as the storefront. */
.section-title{margin-top:12rpx}.section-copy{margin-top:18rpx;font-size:25rpx}.state-card,.error-card{padding:30rpx;border:1rpx solid var(--tc-line);border-radius:12rpx;background:#fff}.state-card__copy{font-size:24rpx;line-height:1.8}.order-list,.address-list,.after-sales-list,.address-form{border-top:0}.order-card,.address-card,.after-sales-card{background:#fff;border:1rpx solid var(--tc-line);border-radius:14rpx;padding:28rpx;margin-bottom:22rpx}.order-card__head,.order-card__foot,.after-sales-card__head,.after-sales-card__foot{font-size:23rpx}.order-card__status,.after-sales-card__head .status{font-size:23rpx;color:#5d6e4b}.order-filter{font-size:24rpx;border-radius:8rpx;background:#fff;border-width:1rpx}.order-filter--active{background:#e9ede1;color:#3c4b2d;border-color:#a9b99a}.address-card__default{background:#edf2e6;color:#5c7048;font-size:21rpx;padding:5rpx 12rpx;border-radius:6rpx}.address-card__phone,.address-card__detail,.address-card__actions{font-size:24rpx}.checkout-section,.detail-card{padding:28rpx;background:#fff;border:1rpx solid var(--tc-line);border-radius:12rpx}.checkout-item image{border-radius:6rpx}.checkout-section__action,.address-detail,.address-missing,.detail-card__copy,.detail-card__hint{font-size:24rpx;line-height:1.8}.checkout-notice{border:0;border-radius:10rpx;font-size:23rpx;line-height:1.8}.order-status-card,.status-card{margin:0 0 30rpx;padding:30rpx 0;background:transparent;color:var(--tc-ink)}.order-status-card .eyebrow,.status-card .eyebrow{color:var(--tc-muted)}.order-status-card__copy,.status-card__copy{color:var(--tc-muted);font-size:25rpx}.field{padding:26rpx;background:#fff;border:1rpx solid var(--tc-line);border-radius:10rpx;margin-top:16rpx}.field__label{font-size:24rpx}.default-row__copy{font-size:23rpx}.favorites-grid{gap:24rpx 20rpx}.favorite-item__remove{font-size:24rpx;border-radius:7rpx;min-height:76rpx;line-height:76rpx}.after-sales-card__reason{font-size:24rpx;line-height:1.75}
/* Order, address and service screens follow the same quiet editorial rhythm. */
.order-card,.address-card,.after-sales-card,.detail-card,.state-card,.error-card{border-radius:4rpx;box-shadow:none}.order-card,.address-card,.after-sales-card{padding:28rpx;margin-bottom:26rpx}.detail-card{padding:30rpx;background:transparent;border:0;border-top:1rpx solid var(--tc-line);border-radius:0}.order-filter{border:0;border-bottom:2rpx solid transparent;border-radius:0;background:transparent;padding:18rpx 12rpx}.order-filter--active{border-bottom-color:var(--tc-ink);background:transparent;color:var(--tc-ink)}.field{border-radius:4rpx}.favorite-item__remove{border-radius:2rpx;background:transparent;border:1rpx solid var(--tc-line)}.order-status-card,.status-card{padding-top:12rpx;padding-bottom:24rpx}.order-card__total{font-size:30rpx}.order-card__items{font-size:25rpx}
