/* Shared storefront surfaces. Keep dark fills for primary actions. */
page{--vk-bg:#f5f5f4;--vk-card:#fff;--vk-line:#e9e9e7;--vk-muted:#737373;--vk-radius:16rpx;background:var(--vk-bg);color:#171717}
.flow-heading{padding:28rpx 4rpx 26rpx}.flow-kicker{font-size:19rpx;letter-spacing:2rpx;color:var(--vk-muted)}.flow-title{font-size:42rpx;font-weight:600;line-height:1.4;margin-top:8rpx}.flow-copy{font-size:24rpx;line-height:1.8;color:var(--vk-muted);margin-top:10rpx}
.flow-card{background:var(--vk-card);border-radius:var(--vk-radius);padding:26rpx;margin-bottom:18rpx}.flow-empty{padding:64rpx 28rpx;background:#fff;border-radius:var(--vk-radius);text-align:center}.flow-empty__title{font-size:30rpx;font-weight:600}.flow-empty__copy{font-size:25rpx;color:var(--vk-muted);line-height:1.8;margin:16rpx 0 28rpx}.flow-page button.primary-button,.flow-page button.secondary-button{min-height:88rpx;border-radius:12rpx;font-size:27rpx}.flow-page .error-panel{margin:16rpx 0;border-radius:12rpx}
