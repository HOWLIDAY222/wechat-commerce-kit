/* Short, non-blocking feedback shared by storefront controls. */
button{transition:opacity .14s ease,transform .14s ease,background-color .14s ease}
button.button-hover,button.vk-pressed,.product.vk-pressed{opacity:.78;transform:scale(.985)}
button[disabled].button-hover,button[disabled].vk-pressed{opacity:1;transform:none}
.media-frame{position:relative;overflow:hidden;background:#f5f5f5}
.media-image{opacity:0;transition:opacity .2s ease}
.media-image--ready{opacity:1}
.media-fallback{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:24rpx;color:#707070;font-size:25rpx;text-align:center;background:#f5f5f5}
.detail-disclosure__body,.care-copy{animation:content-reveal .16s ease-out both}
@keyframes content-reveal{from{opacity:0;transform:translateY(6rpx)}to{opacity:1;transform:translateY(0)}}
@media(prefers-reduced-motion:reduce){button,.product,.media-image{transition:none}button.button-hover,button.vk-pressed,.product.vk-pressed{transform:none}.detail-disclosure__body,.care-copy{animation:none}}

.media-fallback{flex-direction:column;gap:20rpx;z-index:2}.media-fallback button{width:auto!important;min-height:80rpx;padding:16rpx 28rpx;margin:0!important;background:#fff;border:1rpx solid #ddd;border-radius:999rpx;font-size:25rpx;line-height:1.5;color:#111}
