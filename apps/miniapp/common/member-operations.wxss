/* Member service surfaces: monochrome cards, visible actions and generous touch targets. */
page{background:#f5f5f5;color:#151515}
.operations-page{padding:36rpx 32rpx 96rpx;background:#f5f5f5;min-height:78vh;color:#151515}
.operations-eyebrow{font-size:20rpx;line-height:1.7;letter-spacing:2rpx;color:#777}
.operations-title{font-size:46rpx;font-weight:600;line-height:1.35;letter-spacing:0;margin:10rpx 0 24rpx}
.operations-copy{font-size:26rpx;line-height:1.85;color:#6c6c6c}
.operations-section{margin-top:52rpx}
.operations-heading{font-size:31rpx;font-weight:600;line-height:1.5;margin-bottom:24rpx}
.operations-card{padding:32rpx;margin-top:22rpx;background:#fff;border:1rpx solid #e9e9e9;border-radius:22rpx}
.operations-card--soft{background:#ededed;border-color:#ededed}
.operations-card__title{font-size:30rpx;font-weight:600;line-height:1.5;margin-bottom:12rpx}
.operations-balance{display:flex;align-items:center;justify-content:space-between;gap:22rpx;padding:34rpx;background:#191919;color:#fff;border-radius:24rpx}
.operations-balance .operations-copy{color:#d4d4d4;font-size:24rpx}
.operations-balance__number{font-size:70rpx;font-weight:400;line-height:1.25;margin-top:10rpx}
.operations-page button{line-height:1.5;transition:opacity .15s,background-color .15s}
.operations-page .operations-button{display:flex;align-items:center;justify-content:center;width:auto!important;min-height:92rpx;padding:23rpx 30rpx;margin:26rpx 0 0!important;border:1rpx solid #171717;border-radius:14rpx;background:#171717;color:#fff;font-size:27rpx;font-weight:500;line-height:1.6;text-align:center}
.operations-page .operations-button--plain{background:#fff;border-color:#d7d7d7;color:#171717}
.operations-page .operations-link{display:flex;align-items:center;justify-content:center;width:auto!important;min-height:88rpx;padding:20rpx 24rpx;margin:18rpx 0 0!important;border:1rpx solid #d5d5d5;border-radius:14rpx;background:transparent;color:#292929;font-size:26rpx;line-height:1.6;text-align:center;text-decoration:none}
.operations-page .operations-inline{display:flex;align-items:center;justify-content:center;flex:none;width:auto!important;min-width:148rpx;min-height:88rpx;padding:20rpx 26rpx;margin:0!important;border:1rpx solid #171717;border-radius:12rpx;background:#171717;color:#fff;font-size:25rpx;line-height:1.6;white-space:normal}
.operations-balance .operations-inline{background:#fff;border-color:#fff;color:#151515}
.operations-page .operations-button[disabled],.operations-page .operations-inline[disabled],.operations-page .operations-link[disabled]{background:#e9e9e9!important;border-color:#e3e3e3;color:#858585!important}
.operations-page .operations-pressed{opacity:.68}
.operations-row{display:flex;align-items:center;gap:18rpx;padding:28rpx 0;border-bottom:1rpx solid #e7e7e7}
.operations-row__icon{display:flex;align-items:center;justify-content:center;flex:0 0 72rpx;width:72rpx;height:72rpx;border-radius:16rpx;background:#ededed}
.operations-row__icon image{width:36rpx;height:36rpx;opacity:.8}
.operations-row__body{flex:1;min-width:0}
.operations-row__title{font-size:29rpx;font-weight:500;line-height:1.6}
.operations-row__detail{font-size:24rpx;color:#717171;line-height:1.85;margin-top:7rpx}
.operations-row__reward{font-size:26rpx;flex:none;white-space:nowrap}
.operations-meta{font-size:24rpx;line-height:1.85;color:#727272;margin-top:14rpx}
.operations-small{font-size:23rpx;line-height:1.85;color:#787878;margin-top:14rpx}
.operations-label{font-size:27rpx;font-weight:500;line-height:1.65;margin:30rpx 0 16rpx}
.operations-input,.operations-textarea,.operations-picker{box-sizing:border-box;display:block;width:100%;min-height:96rpx;padding:24rpx;border:1rpx solid #dcdcdc;border-radius:14rpx;background:#fff;color:#151515;font-size:27rpx;line-height:1.75}
.operations-textarea{height:240rpx}
.operations-input[disabled],.operations-textarea[disabled]{background:#f1f1f1;color:#8a8a8a}
.operations-status{padding:24rpx 28rpx;margin:24rpx 0;background:#ebebeb;border:1rpx solid #e3e3e3;border-radius:16rpx;color:#555;font-size:25rpx;line-height:1.85}
.operations-status--error{background:#fff;border-color:#c6c6c6;color:#454545}
.operations-question{padding:30rpx 0;border-bottom:1rpx solid #e5e5e5}
.operations-option{display:flex;align-items:center;gap:18rpx;min-height:100rpx;padding:22rpx 24rpx;margin-top:14rpx;border:1rpx solid #dedede;border-radius:14rpx;background:#fff;font-size:27rpx;line-height:1.7;color:#404040}
.operations-option.is-selected{background:#f0f0f0;border-color:#252525;color:#151515}
.operations-option radio,.operations-option checkbox{flex:none;transform:scale(.88);transform-origin:center}
.operations-option text{flex:1;min-width:0}
.operations-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx}
.operations-grid .operations-card{margin-top:0;min-width:0}
.operations-grid .operations-button{margin-top:0!important}
.operations-qr{display:block;width:360rpx;max-width:100%;height:360rpx;padding:16rpx;margin:28rpx auto;background:#fff;border:1rpx solid #e8e8e8;border-radius:16rpx}
.operations-code{font-size:42rpx;font-weight:500;line-height:1.6;letter-spacing:4rpx;overflow-wrap:anywhere;margin:22rpx 0}
.operations-actions{display:flex;align-items:center;gap:16rpx;flex-wrap:wrap}
.operations-actions .operations-button{flex:1;min-width:150rpx}
.operations-post{padding:30rpx;margin-top:22rpx;background:#fff;border:1rpx solid #e7e7e7;border-radius:22rpx}
.operations-post__text{white-space:pre-wrap;font-size:27rpx;line-height:1.9;overflow-wrap:anywhere;margin-top:18rpx}
.operations-post__actions{display:flex;gap:14rpx;flex-wrap:wrap;margin-top:24rpx}
.operations-post__actions button{display:flex;align-items:center;justify-content:center;width:auto!important;min-height:80rpx;min-width:108rpx;padding:18rpx 22rpx;margin:0!important;border:1rpx solid #e0e0e0;border-radius:12rpx;background:#f7f7f7;color:#5c5c5c;font-size:24rpx;line-height:1.6}
.operations-post__actions button.is-active{background:#191919;border-color:#191919;color:#fff}
.operations-confirm{display:flex;align-items:flex-start;gap:12rpx;font-size:24rpx;line-height:1.85;margin-top:28rpx;color:#666}
.operations-confirm checkbox{flex:none;transform:scale(.88);transform-origin:center 6rpx}
.operations-confirm text{flex:1;min-width:0}
.operations-notice{font-size:24rpx;line-height:1.85;color:#666;margin:22rpx 0}
.operations-comment{padding:24rpx;margin-top:22rpx;background:#f3f3f3;border-radius:16rpx}
.operations-comment .operations-row__title{font-size:25rpx}
.operations-comment .operations-post__text{font-size:25rpx;margin-top:12rpx}
@media(max-width:340px){.operations-page{padding-left:26rpx;padding-right:26rpx}.operations-card{padding:26rpx}.operations-balance{padding:28rpx}.operations-page .operations-inline{min-width:132rpx;padding-left:20rpx;padding-right:20rpx}.operations-grid{gap:14rpx}}
