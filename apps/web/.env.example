# Local demo only. Copy through `npm run setup` to generate a unique session secret.
APP_BASE_URL=http://127.0.0.1:3000
SESSION_SECRET=GENERATE_A_LOCAL_SECRET
DEMO_ADMIN_PASSWORD=GENERATE_A_LOCAL_PASSWORD
COMMERCE_STORAGE=prisma
